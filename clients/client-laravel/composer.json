{
    "name": "smartpricing/queen-mq",
    "description": "Queen MQ client library for PHP with optional Laravel integration",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://queenmq.com",
    "keywords": [
        "message-queue",
        "queue",
        "postgresql",
        "postgres",
        "laravel",
        "broker",
        "fifo",
        "consumer-groups"
    ],
    "support": {
        "issues": "https://github.com/queen-mq/queen/issues",
        "source": "https://github.com/queen-mq/queen",
        "docs": "https://queenmq.com/use/clients/php-laravel"
    },
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.0",
        "ramsey/uuid": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Queen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Queen\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Queen\\Laravel\\QueenServiceProvider"
            ],
            "aliases": {
                "Queen": "Queen\\Laravel\\QueenFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
