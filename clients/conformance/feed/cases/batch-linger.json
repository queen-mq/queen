{
  "name": "batch-linger",
  "about": "foreachBatch maxWaitMillis: the items of two reads in one call; nothing commits while they wait",
  "source": {
    "queues": [
      "c-in"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "map",
      "fn": {
        "n": {
          "$get": "0.data.n"
        }
      }
    },
    {
      "op": "foreachBatch",
      "opts": {
        "maxItems": 10,
        "maxWaitMillis": 1500
      }
    }
  ],
  "compareMetrics": [
    "emitted",
    "effects",
    "batches",
    "outputs",
    "retries",
    "poisoned",
    "skipped",
    "deadLettered",
    "pendingBatch"
  ],
  "script": [
    {
      "tx": [
        {
          "at": "2026-11-06T09:00:01.000Z",
          "push": [
            {
              "queue": "c-in",
              "partition": "p1",
              "data": {
                "n": 1
              },
              "transactionId": "i1"
            }
          ]
        },
        {
          "at": "2026-11-06T09:00:02.000Z",
          "push": [
            {
              "queue": "c-in",
              "partition": "p0",
              "data": {
                "n": 2
              },
              "transactionId": "i2"
            }
          ]
        }
      ]
    },
    {
      "start": "A"
    },
    {
      "sleep": 300
    },
    {
      "metrics": "A",
      "as": "waiting",
      "keys": [
        "pendingBatch",
        "batches",
        "commits"
      ]
    },
    {
      "tx": [
        {
          "at": "2026-11-06T09:00:10.000Z",
          "push": [
            {
              "queue": "c-in",
              "partition": "p1",
              "data": {
                "n": 3
              },
              "transactionId": "i3"
            }
          ]
        },
        {
          "at": "2026-11-06T09:00:11.000Z",
          "push": [
            {
              "queue": "c-in",
              "partition": "p0",
              "data": {
                "n": 4
              },
              "transactionId": "i4"
            }
          ]
        }
      ]
    },
    {
      "sleep": 300
    },
    {
      "metrics": "A",
      "as": "still",
      "keys": [
        "pendingBatch",
        "batches",
        "commits"
      ]
    },
    {
      "idle": "A"
    },
    {
      "stop": "A"
    }
  ],
  "run": {
    "queryId": "c-batch-linger"
  },
  "mode": "fake"
}
