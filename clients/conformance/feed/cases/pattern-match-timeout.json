{
  "name": "pattern-match-timeout",
  "about": "an order then its payment within 15 minutes is a match across two queues; an order alone times out on a quiet feed; a second start while one waits is ignored (keep)",
  "source": {
    "queues": [
      "c-orders",
      "c-payments"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "pattern",
      "opts": {
        "start": {
          "$eq": [
            {
              "$get": "0.queue"
            },
            "c-orders"
          ]
        },
        "then": {
          "$eq": [
            {
              "$get": "0.queue"
            },
            "c-payments"
          ]
        },
        "within": "15m",
        "onMatch": {
          "order": {
            "$get": "0.data.id"
          },
          "paid": {
            "$get": "1.data.amount"
          },
          "at": {
            "$get": "1.ts"
          }
        },
        "onTimeout": {
          "order": {
            "$get": "0.data.id"
          },
          "remind": true
        }
      }
    },
    {
      "op": "to",
      "target": "c-followups"
    }
  ],
  "script": [
    {
      "tx": [
        {
          "at": "2026-11-06T09:00:00.000Z",
          "push": [
            {
              "queue": "c-orders",
              "partition": "order-1",
              "data": {
                "id": 1
              },
              "transactionId": "o1"
            }
          ]
        },
        {
          "at": "2026-11-06T09:01:00.000Z",
          "push": [
            {
