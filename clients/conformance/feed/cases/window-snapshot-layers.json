{
  "name": "window-snapshot-layers",
  "about": "a snapshot at every commit: a full layer, then deltas; the next process loads every layer in order",
  "source": {
    "queues": [
      "c-visits"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "windowTumbling",
      "opts": {
        "seconds": 60
      }
    },
    {
      "op": "aggregate",
      "fields": {
        "count": 1,
        "sum": {
          "$get": "0.n"
        }
      }
    },
    {
      "op": "map",
      "fn": {
        "key": {
          "$get": "1.key"
        },
        "start": {
          "$get": "1.windowKey"
        },
        "value": {
          "$get": "0"
        }
      }
    },
    {
      "op": "to",
      "target": "c-visits-out"
    }
  ],
  "timing": {
    "snapshotEveryMillis": 0
  },
  "script": [
    {
