{
  "name": "reset-epoch",
  "about": "reset: true starts over at every start: a new epoch, from the source start again, with outputs of their own",
  "source": {
    "queues": [
      "c-in"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "map",
      "fn": {
        "n": {
          "$get": "0.data.n"
        }
      }
    },
    {
      "op": "to",
      "target": "c-out"
    }
  ],
  "script": [
    {
      "tx": [
        {
          "at": "2026-11-06T09:00:01.000Z",
          "push": [
            {
              "queue": "c-in",
              "partition": "p",
              "data": {
                "n": 1
              },
              "transactionId": "i1"
            }
          ]
        }
      ]
    },
    {
      "start": "A"
    },
    {
      "idle": "A"
    },
    {
      "stop": "A"
    },
    {
      "start": "B",
      "run": {
        "reset": true
      }
    },
    {
      "idle": "B"
    },
    {
      "stop": "B"
    }
  ],
  "run": {
    "queryId": "c-reset-epoch"
  },
  "mode": "fake"
}
