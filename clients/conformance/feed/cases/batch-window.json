      "opts": {
        "seconds": 60
      }
    },
    {
      "op": "aggregate",
      "fields": {
        "count": 1,
        "sum": {
          "$get": "0.n"
        }
      }
    },
    {
      "op": "foreachBatch"
    }
  ],
