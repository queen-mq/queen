{
  "name": "two-windows-feed",
  "about": "a window of window results on the feed clock: each result reaches the next step at the time its window closed",
  "source": {
    "queues": [
      "c-hits"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "windowTumbling",
      "opts": {
        "seconds": 60
      }
    },
    {
      "op": "aggregate",
      "fields": {
        "count": 1
      }
    },
    {
      "op": "windowTumbling",
      "opts": {
        "seconds": 300
      }
    },
    {
      "op": "aggregate",
      "fields": {
        "max": {
          "$get": "0.count"
        },
        "sum": {
          "$get": "0.count"
        }
      }
    },
    {
      "op": "map",
      "fn": {
        "key": {
          "$get": "1.key"
        },
        "start": {
          "$get": "1.windowKey"
        },
        "value": {
          "$get": "0"
        }
      }
    },
    {
      "op": "to",
      "target": "c-five-min"
    }
  ],
  "script": [
    {
      "tx": [
        {
          "at": "2026-11-06T09:00:10.000Z",
          "push": [
            {
              "queue": "c-hits",
