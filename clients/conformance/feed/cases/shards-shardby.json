{
  "name": "shards-shardby",
  "about": "shardBy: a function of the message picks the shard (filtered in the process); a window keyed by the same field",
  "source": {
    "queues": [
      "c-in"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "keyBy",
      "fn": {
        "$get": "0.data.user"
      }
    },
    {
      "op": "windowTumbling",
      "opts": {
        "seconds": 60
      }
    },
    {
      "op": "aggregate",
      "fields": {
        "count": 1
      }
    },
    {
      "op": "map",
      "fn": {
        "user": {
          "$get": "1.key"
        },
        "count": {
          "$get": "0.count"
        }
      }
    },
    {
      "op": "to",
      "target": "c-out"
    }
  ],
  "run": {
    "shardBy": {
      "$get": "0.data.user"
    },
    "queryId": "c-shards-shardby"
  },
