{
  "name": "gather-steps",
  "about": "gather by steps: onComplete when every step is in; a finished run is remembered, so a late duplicate opens nothing; a run missing a step times out with the missing names",
  "source": {
    "queues": [
      "c-pay",
      "c-stock",
      "c-ship"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "gather",
      "opts": {
        "steps": [
          "c-pay",
          "c-stock",
          "c-ship"
        ],
        "key": {
          "$get": "0.data.orderId"
        },
        "within": "5m",
        "onComplete": {
          "order": {
            "$get": "1"
          },
          "got": {
            "$keys": {
              "$get": "0"
            }
          }
        },
        "onTimeout": {
          "order": {
            "$get": "2"
          },
          "missing": {
            "$get": "1"
          },
          "got": {
            "$keys": {
              "$get": "0"
            }
          }
        }
      }
    },
    {
      "op": "name",
      "name": "runs"
    },
    {
      "op": "to",
      "target": "c-gathered"
    }
  ],
  "script": [
    {
      "tx": [
        {
          "at": "2026-11-06T09:00:00.000Z",
          "push": [
            {
              "queue": "c-pay",
