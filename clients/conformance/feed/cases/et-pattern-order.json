{
  "name": "et-pattern-order",
  "about": "a pattern on event time takes its messages in event-time order: a then that arrives before its start, within allowedLateness, still matches; held messages are state, carried by the snapshot to the next process",
  "mode": "both",
  "source": {
    "queues": [
      "c-a",
      "c-b"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "pattern",
      "opts": {
        "start": {
          "$eq": [
            {
              "$get": "0.queue"
            },
            "c-a"
          ]
        },
        "then": {
          "$eq": [
            {
              "$get": "0.queue"
            },
            "c-b"
          ]
        },
        "within": "5m",
        "eventTime": {
          "$get": "0.data.at"
        },
        "allowedLateness": "1m",
        "onMatch": {
          "key": {
            "$get": "0.partition"
          },
          "a": {
            "$get": "0.data.n"
          },
          "b": {
            "$get": "1.data.n"
          }
        },
        "onTimeout": {
          "key": {
            "$get": "0.partition"
          },
          "a": {
            "$get": "0.data.n"
          },
          "timeout": true
        }
      }
    },
    {
      "op": "to",
      "target": "c-et-pattern-out"
    }
  ],
