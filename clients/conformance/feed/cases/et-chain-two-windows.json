{
  "name": "et-chain-two-windows",
  "about": "a window after an event-time window runs on event time too (the results carry their window end) and follows its watermark",
  "source": {
    "queues": [
      "c-readings"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "windowTumbling",
      "opts": {
        "seconds": 60,
        "eventTime": {
          "$get": "0.data.at"
        }
      }
    },
    {
      "op": "aggregate",
      "fields": {
        "count": 1
      }
    },
    {
      "op": "windowTumbling",
      "opts": {
        "seconds": 180
      }
    },
    {
      "op": "aggregate",
      "fields": {
        "max": {
          "$get": "0.count"
        },
        "sum": {
          "$get": "0.count"
        }
      }
    },
    {
      "op": "map",
      "fn": {
        "key": {
          "$get": "1.key"
        },
        "start": {
          "$get": "1.windowKey"
        },
        "value": {
          "$get": "0"
        }
      }
    },
    {
      "op": "to",
      "target": "c-et-chain-out"
    }
  ],
