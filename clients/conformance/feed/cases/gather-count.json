{
  "name": "gather-count",
  "about": "gather by count: a part says how many parts its run has (the largest count wins); complete at that many; a deadline says how many are missing (null when no part said)",
  "source": {
    "queues": [
      "c-parts"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "gather",
      "opts": {
        "count": {
          "$get": "0.data.parts"
        },
        "key": {
          "$get": "0.data.batch"
        },
        "within": "10m",
        "onComplete": {
          "batch": {
            "$get": "1"
          },
          "n": {
            "$len": {
              "$get": "0"
            }
          }
        },
        "onTimeout": {
          "batch": {
            "$get": "2"
          },
          "missing": {
            "$get": "1"
          },
          "n": {
            "$len": {
              "$get": "0"
            }
          }
        }
      }
    },
    {
      "op": "to",
      "target": "c-batches"
    }
  ],
