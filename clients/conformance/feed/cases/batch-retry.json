{
  "name": "batch-retry",
  "about": "foreachBatch: a batch that fails twice, then passes, is tried again whole, with the same items and ids: not poison",
  "source": {
    "queues": [
      "c-in"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "map",
      "fn": {
        "n": {
          "$get": "0.data.n"
        }
      }
    },
    {
      "op": "foreachBatch",
      "fn": {
        "$flaky": {
          "times": 2,
          "key": "batch",
          "then": null
        }
      }
    }
  ],
  "run": {
    "retries": 3,
    "queryId": "c-batch-retry"
  },
  "compareMetrics": [
    "emitted",
    "effects",
    "batches",
    "outputs",
    "retries",
    "poisoned",
    "skipped",
    "deadLettered",
    "pendingBatch"
  ],
  "script": [
    {
      "tx": [
        {
          "at": "2026-11-06T09:00:01.000Z",
          "push": [
            {
              "queue": "c-in",
              "partition": "p1",
              "data": {
                "n": 1
              },
              "transactionId": "i1"
            }
          ]
        },
        {
          "at": "2026-11-06T09:00:02.000Z",
          "push": [
            {
              "queue": "c-in",
              "partition": "p0",
              "data": {
                "n": 2
              },
              "transactionId": "i2"
            }
          ]
        },
        {
          "at": "2026-11-06T09:00:03.000Z",
          "push": [
            {
              "queue": "c-in",
              "partition": "p1",
              "data": {
                "n": 3
              },
              "transactionId": "i3"
            }
          ]
        }
      ]
    },
    {
      "start": "A"
    },
    {
      "idle": "A"
    },
    {
      "stop": "A"
    }
  ],
  "mode": "fake"
}
