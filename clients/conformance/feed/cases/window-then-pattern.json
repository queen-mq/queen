{
  "name": "window-then-pattern",
  "about": "a pattern over window results: two busy minutes in a row for one key",
  "source": {
    "queues": [
      "c-hits"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "windowTumbling",
      "opts": {
        "seconds": 60
      }
    },
    {
      "op": "aggregate",
      "fields": {
        "count": 1
      }
    },
    {
      "op": "filter",
      "fn": {
        "$gte": [
          {
            "$get": "0.count"
          },
          2
        ]
      }
    },
    {
      "op": "pattern",
      "opts": {
        "start": true,
        "then": true,
        "within": "90s",
        "onMatch": {
          "key": {
            "$get": "0.partition"
          },
          "first": {
            "$get": "0.data.count"
          },
          "second": {
            "$get": "1.data.count"
          },
          "firstCtx": {
            "$get": "0.ctx.windowKey"
          }
        }
      }
    },
    {
      "op": "to",
      "target": "c-busy"
    }
  ],
