{
  "name": "poison-flaky",
  "about": "a function that fails twice and then passes is retried, not poison",
  "source": {
    "queues": [
      "c-in"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "map",
      "fn": {
        "$flaky": {
          "times": 2,
          "key": {
            "$get": "0.transactionId"
          },
          "then": {
            "n": {
              "$get": "0.data.n"
            }
          }
        }
      }
    },
    {
      "op": "to",
      "target": "c-out"
    }
  ],
  "run": {
    "retries": 3,
    "queryId": "c-poison-flaky"
  },
  "compareMetrics": [
    "outputs",
    "poisoned",
    "retries"
  ],
  "script": [
    {
      "tx": [
        {
          "at": "2026-11-06T09:00:01.000Z",
          "push": [
            {
              "queue": "c-in",
              "partition": "p",
              "data": {
                "n": 1
              },
              "transactionId": "i1"
            }
          ]
        },
        {
          "at": "2026-11-06T09:00:02.000Z",
          "push": [
            {
              "queue": "c-in",
              "partition": "p",
              "data": {
                "n": 2
              },
              "transactionId": "i2"
            }
          ]
        }
      ]
    },
    {
      "start": "A"
    },
    {
      "idle": "A"
    },
    {
      "stop": "A"
    }
  ],
  "mode": "fake"
}
