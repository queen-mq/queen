{
  "name": "et-takeover-stop",
  "about": "event-time windows across a stop: the next process (another SDK with --cross) loads the snapshot the first wrote and closes every window once",
  "mode": "both",
  "source": {
    "queues": [
      "c-readings"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "windowTumbling",
      "opts": {
        "seconds": 60,
        "eventTime": {
          "$get": "0.data.at"
        }
      }
    },
    {
      "op": "aggregate",
      "fields": {
        "count": 1,
        "sum": {
          "$get": "0.v"
        }
      }
    },
    {
      "op": "map",
      "fn": {
        "key": {
          "$get": "1.key"
        },
        "start": {
          "$get": "1.windowKey"
        },
        "value": {
          "$get": "0"
        }
      }
    },
    {
      "op": "to",
      "target": "c-et-out"
    }
  ],
