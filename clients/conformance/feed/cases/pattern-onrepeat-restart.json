{
  "name": "pattern-onrepeat-restart",
  "about": "onRepeat 'restart': a new start replaces the waiting one, and the deadline counts from it; a then exactly `within` after is in time",
  "source": {
    "queues": [
      "c-orders",
      "c-payments"
    ],
    "from": "earliest"
  },
  "chain": [
    {
      "op": "pattern",
      "opts": {
        "start": {
          "$eq": [
            {
              "$get": "0.queue"
            },
            "c-orders"
          ]
        },
        "then": {
          "$eq": [
            {
              "$get": "0.queue"
            },
            "c-payments"
          ]
        },
        "within": "15m",
        "onMatch": {
          "order": {
            "$get": "0.data.id"
          },
          "paid": {
            "$get": "1.data.amount"
          },
          "at": {
            "$get": "1.ts"
          }
        },
        "onTimeout": {
          "order": {
            "$get": "0.data.id"
          },
          "remind": true
        },
        "onRepeat": "restart"
      }
    },
    {
      "op": "to",
      "target": "c-followups"
    }
  ],
  "script": [
    {
      "tx": [
        {
          "at": "2026-11-06T09:00:00.000Z",
          "push": [
            {
              "queue": "c-orders",
              "partition": "order-1",
              "data": {
                "id": 1
              },
              "transactionId": "o1"
            }
          ]
        },
        {
          "at": "2026-11-06T09:10:00.000Z",
          "push": [
            {
              "queue": "c-orders",
              "partition": "order-1",
              "data": {
                "id": 2
              },
              "transactionId": "o2"
            }
          ]
        },
        {
          "at": "2026-11-06T09:25:00.000Z",
          "push": [
            {
              "queue": "c-payments",
              "partition": "order-1",
              "data": {
                "amount": 5
              },
              "transactionId": "p1"
            }
          ]
        },
        {
          "at": "2026-11-06T09:26:40.000Z",
          "push": [
            {
              "queue": "c-orders",
              "partition": "order-3",
              "data": {
                "id": 3
              },
              "transactionId": "o3"
            }
          ]
        }
      ]
    },
    {
      "start": "A"
    },
    {
      "idle": "A"
    },
    {
      "clock": "2026-11-06T09:41:40.000Z"
    },
    {
      "idle": "A"
    },
    {
      "tx": [
        {
          "at": "2026-11-06T09:41:40.000Z",
          "push": [
            {
              "queue": "c-payments",
              "partition": "order-3",
              "data": {
                "amount": 7
              },
              "transactionId": "p3"
            }
          ]
        }
      ]
    },
    {
      "idle": "A"
    },
    {
      "stop": "A"
    }
  ],
  "run": {
    "queryId": "c-pattern-onrepeat-restart"
  },
  "mode": "fake"
}
