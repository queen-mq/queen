{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "queen/laravel-supervisor-benchmark",
    "description": "Reproducible Laravel fixture for Horizon, Queen PHP and Queen Rust supervisor comparisons",
    "type": "project",
    "license": "Apache-2.0",
    "repositories": [
        {
            "type": "path",
            "url": "../../../clients/client-laravel",
            "options": {
                "symlink": false,
                "versions": {
                    "smartpricing/queen-mq": "dev-main"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-posix": "*",
        "ext-redis": "*",
        "laravel/framework": "12.68.0",
        "laravel/horizon": "5.48.3",
        "smartpricing/queen-mq": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
