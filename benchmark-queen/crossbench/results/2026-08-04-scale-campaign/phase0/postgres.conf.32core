# Shared Postgres configuration for the CM-BENCH campaign.
#
# BYTE-IDENTICAL between the Queen run and the pgmq run. That is the single
# thing that makes those two comparable: same substrate, same durability, same
# tuning, so every difference is architecture (SPEC.md §5.1, §5.3).
#
# Sized for an 8-core / 16 GB broker VM. If the VM differs, change it HERE and
# re-run both systems — never tune one side only.

# ---- durability -------------------------------------------------------------
# fsync on every commit. This is the tier Kafka's default config does NOT match
# (it flushes lazily and leans on replication), which is why Kafka is run in
# both tiers and both are reported.
synchronous_commit = on
fsync = on
wal_level = replica
full_page_writes = on

# ---- memory -----------------------------------------------------------------
# July's 62 GB rig needed shared_buffers 16 GB / work_mem 12 MB /
# maintenance_work_mem 512 MB to survive the first autovacuum burst. Scaled to
# 16 GB: a quarter of RAM to shared_buffers, and maintenance kept deliberately
# small so four autovacuum workers cannot spike the box (the July OOM was
# 4 workers x maintenance_work_mem, not steady-state usage).
shared_buffers = 16GB
effective_cache_size = 45GB
work_mem = 32MB
maintenance_work_mem = 2GB

# ---- WAL --------------------------------------------------------------------
wal_buffers = 128MB
min_wal_size = 4GB
max_wal_size = 32GB
checkpoint_timeout = 15min
checkpoint_completion_target = 0.9

# ---- connections ------------------------------------------------------------
# This file REPLACES the image's postgresql.conf, so anything the image used to
# set has to be set here. listen_addresses is the one that bites: without it
# Postgres binds loopback only, the container's published port connects and is
# then dropped, and the client reports a confusing "unexpected EOF".
listen_addresses = '*'
port = 5432

# pgmq is a library: every concurrent operation is a backend unless a pooler
# coalesces it. The limit is generous so the run measures pgmq's architecture
# rather than a connection ceiling we imposed.
max_connections = 600

# ---- autovacuum -------------------------------------------------------------
# Both engines churn hard: pgmq does UPDATE+DELETE per delivery, Queen updates
# allocator rows. July measured wildcard candidate scans degrading from ~2 ms to
# 12-35 ms purely from dead versions between vacuums, so autovacuum runs
# aggressively and is NOT a tuning advantage for either side.
autovacuum = on
autovacuum_max_workers = 8
autovacuum_naptime = 10s
autovacuum_vacuum_scale_factor = 0.02
autovacuum_analyze_scale_factor = 0.01
autovacuum_vacuum_cost_delay = 0
log_autovacuum_min_duration = 1000

# ---- planner / parallelism --------------------------------------------------
random_page_cost = 1.1
effective_io_concurrency = 200
max_parallel_workers = 8
max_parallel_workers_per_gather = 2
max_worker_processes = 16

# ---- observability ----------------------------------------------------------
# The campaign reads commits/s, WAL bytes/s and dead tuples out of these.
track_io_timing = on
track_counts = on
shared_preload_libraries = 'pg_stat_statements'
pg_stat_statements.track = all
log_checkpoints = on
log_min_duration_statement = 5000
