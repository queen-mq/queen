# hosts.env — sourced by every script (copy to hosts.env and fill in on VM day). SPEC.md §1.
B_PUB=(0.0.0.1 0.0.0.2 0.0.0.3)                  # brokers, public IPs (ssh from the Mac)
B_PRIV=(10.114.0.2 10.114.0.3 10.114.0.4)        # brokers, VPC IPs on eth1 (NOT the 10.x anchor IP on eth0)
L_PUB=(0.0.0.4 0.0.0.5 0.0.0.6)                  # loaders, public IPs
L_PRIV=(10.114.0.5 10.114.0.6 10.114.0.7)        # loaders, private IPs
SSH="ssh -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=10"
REMOTE_ROOT=/root/bench
PROFILE=vm                                       # vm | local
CACHE=                                           # dir on each host with pre-fetched tarballs (empty = download)
