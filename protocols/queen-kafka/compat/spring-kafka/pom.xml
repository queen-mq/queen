<?xml version="1.0" encoding="UTF-8"?>
<!--
  queen-kafka compat suite: Spring Boot 3.x + spring-kafka.

  Deliberately a plain Spring Boot application, not a test harness: the point is to
  drive the SAME auto-configuration a real Boot service gets (KafkaAutoConfiguration,
  KafkaTemplate, @KafkaListener / ConcurrentMessageListenerContainer) against the
  queen-kafka facade.  Nothing here is published; `mvn package` produces a fat jar
  under target/ which run.sh then launches.

  We pin NOTHING about kafka-clients on purpose - the whole point is to record which
  kafka-clients version the Boot BOM drags in.  spring-kafka is the only Kafka
  dependency declared.  lz4-java / zstd-jni / snappy-java arrive transitively at
  `runtime` scope from kafka-clients, so all three codecs are available without
  extra declarations (they are NOT <optional> in kafka-clients 3.x).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.queenmq.compat</groupId>
  <artifactId>queen-kafka-spring-compat</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>queen-kafka spring-kafka compat</name>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>queen-kafka-spring-compat</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
