%% The brod row of the M6 client matrix.
%%
%% Versions are PINNED, not ranged, because this suite's job is to say exactly
%% what was proved. `rebar.lock` is committed beside this file for the same
%% reason. Bump both together and re-run.
%%
%% brod pulls kafka_protocol (the wire codec), crc32cer (a cmake-built NIF for
%% the RecordBatch v2 CRC) and telemetry. The three codec libraries below are
%% NOT brod dependencies -- kafka_protocol calls them through
%% `kpro_compress:do_compress/2` only if the app happens to be loaded, so a
%% stock `{deps,[brod]}` project can send gzip (OTP's own zlib) and NOTHING
%% else. Naming them here is what makes the snappy/lz4/zstd lanes testable at
%% all, and it is also the honest answer to "which codecs does brod support":
%% one out of the box, four if you ask for them.
{erl_opts, [debug_info]}.

{deps, [ {brod, "4.6.3"}
       , {snappyer, "1.2.10"}   %% kpro_compress -> snappyer
       , {lz4b, "0.1.0"}        %% kpro_compress -> lz4b_frame
       , {ezstd, "1.2.4"}       %% kpro_compress -> ezstd
       ]}.

{shell, [{apps, [qk_brod]}]}.
