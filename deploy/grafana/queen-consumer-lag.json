{
  "title": "Queen consumer group lag",
  "uid": "queen-consumer-lag",
  "description": "How far each Queen consumer group is behind on each queue, from queen_consumer_group_lag_* (queen-mq/queen#146). The raft leader exports them every METRICS_FLUSH_MS.",
  "tags": [
    "queen"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(queen_consumer_group_lag_seconds, tenant)",
          "refId": "tenant"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "description": "Empty for a broker without tenants: the default tenant carries no tenant label."
      },
      {
        "name": "queue",
        "label": "Queue",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(queen_consumer_group_lag_seconds{tenant=~\"$tenant\"}, queue)",
          "refId": "queue"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "group",
        "label": "Consumer group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(queen_consumer_group_lag_seconds{tenant=~\"$tenant\",queue=~\"$queue\"}, group)",
          "refId": "group"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Groups behind more than a minute",
      "description": "Groups whose oldest unconsumed message is older than 60 s: the console's 'needs you' line.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (tenant, queue, group) (queen_consumer_group_lag_seconds{tenant=~\"$tenant\",queue=~\"$queue\",group=~\"$group\"}) > 60) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Messages behind",
      "description": "Messages the selected groups have not consumed, over their queues and partitions.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max by (tenant, queue, group) (queen_consumer_group_lag_messages{tenant=~\"$tenant\",queue=~\"$queue\",group=~\"$group\"})) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Most behind",
      "description": "The oldest message any selected group has not consumed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(queen_consumer_group_lag_seconds{tenant=~\"$tenant\",queue=~\"$queue\",group=~\"$group\"}) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Lag read",
      "description": "Complete when the leader read every consumer position at its last metrics bucket; Skipped past QUEEN_METRICS_GROUP_LAG_MAX_CURSORS, and then the per-group series are absent.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(queen_consumer_group_lag_complete)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Complete",
                  "color": "green"
                },
                "0": {
                  "text": "Skipped",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Oldest unconsumed message, by group",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Age of the oldest message each group has not consumed, the ten most behind. 0 means caught up.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, max by (tenant, queue, group) (queen_consumer_group_lag_seconds{tenant=~\"$tenant\",queue=~\"$queue\",group=~\"$group\"}))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{queue}} \u00b7 {{group}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Messages behind, by group",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Messages each group has not consumed, summed over the queue's partitions, the ten largest.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, max by (tenant, queue, group) (queen_consumer_group_lag_messages{tenant=~\"$tenant\",queue=~\"$queue\",group=~\"$group\"}))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{queue}} \u00b7 {{group}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Every group now",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "One row per consumer group and queue, the most behind first.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (tenant, queue, group) (queen_consumer_group_lag_seconds{tenant=~\"$tenant\",queue=~\"$queue\",group=~\"$group\"})",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (tenant, queue, group) (queen_consumer_group_lag_messages{tenant=~\"$tenant\",queue=~\"$queue\",group=~\"$group\"})",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (tenant, queue, group) (queen_consumer_group_partitions_behind{tenant=~\"$tenant\",queue=~\"$queue\",group=~\"$group\"})",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Oldest unconsumed",
              "Value #B": "Messages behind",
              "Value #C": "Partitions behind",
              "tenant": "Tenant",
              "queue": "Queue",
              "group": "Group"
            },
            "indexByName": {
              "tenant": 0,
              "queue": 1,
              "group": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Oldest unconsumed",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Oldest unconsumed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
