---
import { Code } from "astro:components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Figure from "../components/Figure.astro";
import { config } from "virtual:nimbus/config";
import {
  HOME_TITLE,
  hero,
  guideSection,
  guideRun,
  guideSteps,
  guideClosing,
  dashboardShot,
  proofSection,
  proof,
  provenSection,
  proven,
  nextSection,
  start,
  book,
  closing,
} from "../lib/home";
import { GUIDE_LANGS, guideCode } from "../lib/home-guide";
import edition from "../../public/book/edition.json";

/**
 * The landing page. Every word on it comes from src/lib/home.ts, which the
 * markdown twin (index.md.ts) reads too. Elements marked `data-md` are the
 * ones scripts/check-markdown.mjs looks for in dist/index.md.
 *
 * The rhythm: a split hero, then the five-minute guide, then sections that
 * alternate between the page and a card-coloured band: the numbers, proof,
 * where to go next, and the closing line.
 *
 * The guide renders every language's code for every step; the language picker
 * sets `data-guide-lang` on the section and CSS shows the matching variant.
 * Without JavaScript the page shows JavaScript, the first language.
 */
const REPO_BLOB = "https://github.com/queen-mq/queen/blob/master/";

// The same pair Nimbus configures for MDX code blocks, with defaultColor off:
// each span carries the light colour plus a `--shiki-dark` custom property,
// and globals.css flips it under [data-mode="dark"].
const SHIKI = { light: "github-light", dark: "github-dark" } as const;

const eyebrow = "text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-muted-foreground";
const h2 = "mt-3 text-2xl font-semibold tracking-tight text-foreground lg:text-[1.875rem] lg:leading-[1.15]";
const lead = "mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground";
// Tone, as in the console: a card is a filled area, never an outline.
const card = "block rounded-card bg-card p-5 no-underline transition-colors hover:bg-selected";
const cardStatic = "block rounded-card bg-card p-5";
---

<BaseLayout title={HOME_TITLE} description={config.description}>
  <div class="flex min-h-screen flex-col">
    <Header transparentTop showSidebar={false} />

    <main class="w-full flex-1">
      {/* Hero: full height, two halves from lg up; the scene fills the right
          42% under the clear header. Below lg the scene sits under the text. */}
      <section class="lg:-mt-[calc(3.5rem+1px)] lg:grid lg:min-h-svh lg:grid-cols-[minmax(0,1fr)_42%]">
        <div class="flex lg:items-center lg:justify-center lg:px-16 xl:px-24">
          <div class="mx-auto w-full max-w-6xl px-6 pb-12 pt-12 lg:max-w-[30rem] lg:px-0 lg:py-24">
            <p class={eyebrow}>{hero.eyebrow}</p>
            <h1 data-md class="mt-5 text-foreground">
              <span
                class="block"
                style="font-size: clamp(2.25rem, 3.4vw, 3.125rem); line-height: 1.04; font-weight: var(--nb-h1-weight); letter-spacing: -0.035em;"
              >
                {hero.headline}
              </span>
              {" "}
              <span
                class="block text-muted-foreground"
                style="font-size: clamp(2.25rem, 3.4vw, 3.125rem); line-height: 1.04; font-weight: var(--nb-h1-weight); letter-spacing: -0.035em;"
              >
                {hero.subline}
              </span>
            </h1>
            <p data-md class="mt-6 text-[1.0625rem] leading-relaxed text-foreground/85">{hero.lead}</p>
            <p data-md class="mt-4 text-[0.9375rem] leading-relaxed text-muted-foreground">{hero.second}</p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href={hero.primary.href}
                class="rounded-ctl bg-primary px-4 py-2 text-[0.8125rem] font-medium text-primary-foreground no-underline transition-colors hover:bg-primary-hover"
              >
                {hero.primary.label}
              </a>
              <a
                href={hero.secondary.href}
                class="rounded-ctl bg-muted px-4 py-2 text-[0.8125rem] font-medium text-foreground no-underline transition-colors hover:bg-selected"
              >
                {hero.secondary.label}
              </a>
              <a
                href="https://github.com/queen-mq/queen"
                class="px-2 py-2 text-[0.8125rem] text-muted-foreground no-underline transition-colors hover:text-foreground"
              >
                GitHub →
              </a>
            </div>

            <div class="mt-8 rounded-ctl bg-card px-4 py-3">
              <pre class="overflow-x-auto text-[0.75rem] leading-relaxed text-foreground"><code><span class="select-none text-muted-foreground">$ </span>{hero.run}</code></pre>
            </div>
            <p class="mt-3 text-[0.8125rem] text-muted-foreground">{hero.runNote}</p>
          </div>
        </div>

        <div class="relative aspect-[4/5] w-full sm:mx-auto sm:mb-12 sm:max-w-xl sm:overflow-hidden sm:rounded-xl lg:mx-0 lg:mb-0 lg:aspect-auto lg:max-w-none lg:rounded-none">
          <img
            src="/queen-scene-on-light.svg"
            alt=""
            width="1200"
            height="1536"
            class="hero-scene-light absolute inset-0 h-full w-full object-cover"
            style="object-position: 48% 50%;"
          />
          <img
            src="/queen-scene-on-dark.svg"
            alt=""
            width="1200"
            height="1536"
            class="hero-scene-dark absolute inset-0 h-full w-full object-cover"
            style="object-position: 48% 50%;"
          />
        </div>
      </section>

      {/* The five-minute guide */}
      <section id="guide" data-guide-lang="js" class="scroll-mt-14">
        <div class="mx-auto w-full max-w-5xl px-6 pt-20 lg:px-10 lg:pt-28">
          <p class={eyebrow}>{guideSection.eyebrow}</p>
          <h2 data-md class={h2}>{guideSection.title}</h2>
          {guideSection.lead.map((t) => <p data-md class={lead}>{t}</p>)}
        </div>

        <div class="guide-bar sticky top-14 z-20 mt-10">
          <div
            class="mx-auto flex w-full max-w-5xl items-center gap-1.5 overflow-x-auto px-6 py-2.5 lg:px-10"
            role="group"
            aria-label={guideSection.pick}
          >
            <span class="mr-2 hidden shrink-0 text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-muted-foreground sm:inline">
              {guideSection.pick}
            </span>
            {
              GUIDE_LANGS.map((l, i) => (
                <button type="button" class="guide-pick" data-guide-pick={l.id} aria-pressed={i === 0 ? "true" : "false"}>
                  {l.label}
                </button>
              ))
            }
          </div>
        </div>

        <div class="mx-auto w-full max-w-5xl px-6 pb-20 lg:px-10 lg:pb-28">
          <ol class="mt-4">
            <li class="guide-step">
              <div class="guide-num" aria-hidden="true">1</div>
              <div class="min-w-0">
                <h3 data-md class="guide-title">{guideRun.title}</h3>
                {guideRun.body.map((t) => <p data-md class="guide-text">{t}</p>)}
                <div class="mt-5 rounded-ctl bg-card px-4 py-3">
                  <pre class="overflow-x-auto text-[0.75rem] leading-relaxed text-foreground"><code><span class="select-none text-muted-foreground">$ </span>{hero.run}</code></pre>
                </div>
                <p data-md class="guide-text mt-5">{guideRun.installNote}</p>
                {
                  GUIDE_LANGS.map((l) => (
                    <div class="guide-variant mt-3 rounded-ctl bg-card px-4 py-3" data-lang={l.id}>
                      <pre class="overflow-x-auto text-[0.75rem] leading-relaxed text-foreground"><code>{l.install.split("\n").map((cmd, j) => <>{j > 0 && "\n"}<span class="select-none text-muted-foreground">$ </span>{cmd}</>)}</code></pre>
                    </div>
                  ))
                }
                <figure class="mt-6">
                  <div class="overflow-hidden rounded-card bg-card p-2">
                    {/* WebP at 2048 wide: twice the 1024px the frame reaches, so it stays
                        sharp on a 2x screen. Only the visible one loads: a lazy image
                        that is not rendered is not fetched. */}
                    <img
                      src={`/screenshots/${dashboardShot.image}-light.webp`}
                      alt={dashboardShot.alt}
                      width="2048"
                      height="1280"
                      loading="lazy"
                      decoding="async"
                      class="home-shot-light block h-auto w-full rounded-ctl"
                    />
                    <img
                      src={`/screenshots/${dashboardShot.image}-dark.webp`}
                      alt={dashboardShot.alt}
                      width="2048"
                      height="1280"
                      loading="lazy"
                      decoding="async"
                      class="home-shot-dark block h-auto w-full rounded-ctl"
                    />
                  </div>
                  <figcaption class="mt-3 text-[0.8125rem] text-muted-foreground">
                    {dashboardShot.caption} <a href="/manage/upgrades-monitoring/">Monitoring →</a>
                  </figcaption>
                </figure>
              </div>
            </li>

            {
              guideSteps.map((step, n) => (
                <li class="guide-step" id={`guide-${step.id}`}>
                  <div class="guide-num" aria-hidden="true">{n + 2}</div>
                  <div class="min-w-0">
                    <h3 data-md class="guide-title">{step.title}</h3>
                    {step.body.map((t) => <p data-md class="guide-text">{t}</p>)}
                    {step.code.map((c, ci) => (
                      <>
                        {GUIDE_LANGS.map((l) => {
                          const code = guideCode(l, c.id);
                          return code === null ? (
                            <div class="guide-variant mt-5 rounded-card bg-card px-5 py-4 text-[0.875rem] leading-relaxed text-muted-foreground" data-lang={l.id}>
                              {l.missing?.[c.id]}
                            </div>
                          ) : (
                            <div class="guide-variant home-code mt-5 overflow-hidden rounded-card bg-card" data-lang={l.id}>
                              <div class="flex items-center justify-between border-b border-line px-5 py-2.5 text-xs text-muted-foreground">
                                <span class="font-medium">{c.caption}</span>
                                <span>{l.label}</span>
                              </div>
                              <div class="overflow-x-auto px-5 py-4 text-[0.75rem]">
                                <Code code={code} lang={l.lang as any} themes={SHIKI} defaultColor={false} />
                              </div>
                            </div>
                          );
                        })}
                        {step.between?.[ci] && <p data-md class="guide-text mt-6">{step.between[ci]}</p>}
                      </>
                    ))}
                    <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-[0.8125rem] font-medium">
                      {step.links.map((k) => (
                        <a href={k.href}>{k.label} →</a>
                      ))}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>

          <p data-md class="mt-14 max-w-2xl text-[1.0625rem] leading-relaxed text-foreground/85">{guideClosing}</p>
          {
            GUIDE_LANGS.map((l) => (
              <p class="guide-variant mt-4 text-[0.8125rem] text-muted-foreground" data-lang={l.id}>
                {guideSection.programLabel}:{" "}
                <a href={`${REPO_BLOB}${l.file}`} class="font-mono text-[0.75rem]">
                  {l.file}
                </a>
              </p>
            ))
          }
        </div>

        <script is:inline>
          (function () {
            var root = document.getElementById("guide");
            if (!root) return;
            var KEY = "queen-guide-lang";
            var LANGS = ["js", "py", "go", "rust", "php", "cpp"];
            function set(lang) {
              root.setAttribute("data-guide-lang", lang);
              root.querySelectorAll("[data-guide-pick]").forEach(function (b) {
                b.setAttribute("aria-pressed", String(b.getAttribute("data-guide-pick") === lang));
              });
            }
            try {
              var saved = localStorage.getItem(KEY);
              if (saved && LANGS.indexOf(saved) >= 0) set(saved);
            } catch (e) {}
            root.addEventListener("click", function (e) {
              var b = e.target.closest && e.target.closest("[data-guide-pick]");
              if (!b) return;
              var lang = b.getAttribute("data-guide-pick");
              // Code above the reader changes height with the language: keep the
              // step they are reading where it is on screen.
              var bar = root.querySelector(".guide-bar").getBoundingClientRect().bottom;
              var anchor = Array.prototype.find.call(root.querySelectorAll(".guide-step"), function (s) {
                return s.getBoundingClientRect().bottom > bar;
              });
              var before = anchor ? anchor.getBoundingClientRect().top : 0;
              set(lang);
              if (anchor) window.scrollBy(0, anchor.getBoundingClientRect().top - before);
              try {
                localStorage.setItem(KEY, lang);
              } catch (e) {}
            });
          })();
        </script>
      </section>

      {/* Numbers */}
      <section class="bg-zone">
        <div class="mx-auto w-full max-w-5xl px-6 py-20 lg:px-10 lg:py-28">
          <p class={eyebrow}>{proofSection.eyebrow}</p>
          <h2 data-md class={h2}>{proofSection.title}</h2>
          <p data-md class={lead}>{proofSection.lead}</p>
          <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
            {
              proof.map((p) => {
                const Tag = p.href ? "a" : "div";
                return (
                  <Tag href={p.href} class={p.href ? card : cardStatic}>
                    <div class="text-2xl font-semibold tracking-tight text-foreground">{p.figure}</div>
                    <div class="mt-1 text-[0.6875rem] uppercase tracking-wide text-muted-foreground">{p.unit}</div>
                    <p data-md class="mt-3 text-[0.8125rem] leading-relaxed text-muted-foreground">{p.body}</p>
                  </Tag>
                );
              })
            }
          </div>
          <div class="mt-12">
            <Figure id="benchmarks/partitions-p99" />
          </div>
          <a href={proofSection.link.href} class="mt-8 inline-block text-[0.8125rem] font-medium">
            {proofSection.link.label} →
          </a>
        </div>
      </section>

      {/* Proven */}
      <section>
        <div class="mx-auto w-full max-w-5xl px-6 py-20 lg:px-10 lg:py-28">
          <p class={eyebrow}>{provenSection.eyebrow}</p>
          <h2 data-md class={h2}>{provenSection.title}</h2>
          <div class="mt-12 grid grid-cols-1 gap-x-12 gap-y-10 sm:grid-cols-3">
            {
              proven.map((d) => (
                <div>
                  <h3 class="text-[0.9375rem] font-medium text-foreground">
                    <a href={d.href} class="no-underline">
                      {d.title}
                    </a>
                  </h3>
                  <p data-md class="mt-2 text-[0.9375rem] leading-relaxed text-muted-foreground">{d.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      {/* Next */}
      <section class="bg-zone">
        <div class="mx-auto w-full max-w-5xl px-6 py-20 lg:px-10 lg:py-24">
          <p class={eyebrow}>{nextSection.eyebrow}</p>
          <h2 data-md class={h2}>{nextSection.title}</h2>
          <a href={book.href} class="mt-10 flex items-center gap-5 rounded-card bg-card p-4 no-underline transition-colors hover:bg-selected">
            <img src="/book/cover.webp" alt="" width={edition.cover[0]} height={edition.cover[1]} loading="lazy" decoding="async" class="w-16 shrink-0 rounded shadow-md sm:w-20" />
            <div class="min-w-0">
              <div class="text-[0.9375rem] font-medium text-foreground">{book.title}</div>
              <p data-md class="mt-1 text-[0.875rem] leading-relaxed text-muted-foreground">{book.body}</p>
              <p class="mt-2 text-[0.8125rem] font-medium text-foreground">Read it: PDF, {edition.pages} pages →</p>
            </div>
          </a>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              start.map((s) => (
                <a href={s.href} class={card}>
                  <div class="text-[0.9375rem] font-medium text-foreground">{s.title}</div>
                  <p class="mt-1 text-[0.8125rem] leading-relaxed text-muted-foreground">{s.body}</p>
                </a>
              ))
            }
          </div>
          <p data-md class="mt-12 text-[0.9375rem] leading-relaxed text-muted-foreground">{nextSection.mcpNote}</p>
          <div class="mt-3 max-w-3xl rounded-ctl bg-card px-4 py-3">
            <pre class="overflow-x-auto text-[0.75rem] leading-relaxed text-foreground"><code><span class="select-none text-muted-foreground">$ </span>{nextSection.mcp}</code></pre>
          </div>
        </div>
      </section>

      {/* The last line */}
      <section>
        <div class="mx-auto w-full max-w-5xl px-6 py-20 lg:px-10 lg:py-28">
          <p
            data-md
            class="text-center font-semibold text-foreground"
            style="font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1.1; letter-spacing: -0.03em;"
          >
            {closing}
          </p>
        </div>
      </section>

      <footer>
        <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-6 py-8 text-[0.8125rem] text-muted-foreground lg:px-10">
          <span>Apache 2.0</span>
          <a href="https://github.com/queen-mq/queen">GitHub</a>
          <a href="/reference/">Reference</a>
          <a href="/benchmarks/">Benchmarks</a>
          <a href="/reference/http/">HTTP API</a>
          <a href="/reference/changelog/">Changelog</a>
          <a href="/introduction/about/" class="ml-auto">Built at Smartness.</a>
        </div>
      </footer>
    </main>
  </div>
</BaseLayout>

<style>
  /* Code on this page sits in a card that already has a frame and a header:
     Shiki's own background, padding and border would be a box in a box. */
  .home-code :global(pre.astro-code) {
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent !important;
    /* the wrapper scrolls; a second scroller here showed an empty track */
    overflow: visible !important;
  }
  /* The hero scene and the dashboard screenshot exist once per theme.
     BaseLayout stamps data-mode="dark" on <html> for the dark theme only. */
  .hero-scene-dark,
  .home-shot-dark {
    display: none;
  }

  /* The guide: numbered steps, one language visible at a time. */
  /* Opaque: the code scrolling under a translucent bar stayed readable through it. */
  .guide-bar {
    background: var(--nb-background);
  }
  .guide-pick {
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid transparent;
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--nb-muted-foreground, var(--muted-foreground));
    transition: color 120ms, border-color 120ms, background-color 120ms;
  }
  .guide-pick:hover {
    color: var(--nb-foreground, var(--foreground));
  }
  .guide-pick[aria-pressed="true"] {
    color: var(--nb-foreground, var(--foreground));
    background: var(--nb-selected);
  }
  .guide-step {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 1.25rem;
    padding-top: 3.5rem;
    scroll-margin-top: 7rem;
  }
  .guide-num {
    display: flex;
    height: 2rem;
    width: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--nb-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--nb-foreground, var(--foreground));
  }
  .guide-title {
    margin-top: 0.25rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--nb-foreground, var(--foreground));
  }
  .guide-text {
    margin-top: 0.75rem;
    max-width: 42rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--nb-muted-foreground, var(--muted-foreground));
  }
  .guide-variant {
    display: none;
  }
  #guide[data-guide-lang="js"] .guide-variant[data-lang="js"],
  #guide[data-guide-lang="py"] .guide-variant[data-lang="py"],
  #guide[data-guide-lang="go"] .guide-variant[data-lang="go"],
  #guide[data-guide-lang="rust"] .guide-variant[data-lang="rust"],
  #guide[data-guide-lang="php"] .guide-variant[data-lang="php"],
  #guide[data-guide-lang="cpp"] .guide-variant[data-lang="cpp"] {
    display: block;
  }
  @media (max-width: 639px) {
    .guide-step {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
    /* Five languages fit a 375px phone without scrolling the bar. */
    .guide-pick {
      padding: 0.25rem 0.5rem;
      font-size: 0.75rem;
    }
  }
  :global(:root[data-mode="dark"]) .hero-scene-light,
  :global(:root[data-mode="dark"]) .home-shot-light {
    display: none;
  }
  :global(:root[data-mode="dark"]) .hero-scene-dark,
  :global(:root[data-mode="dark"]) .home-shot-dark {
    display: block;
  }
</style>
