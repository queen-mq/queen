---
import { Code } from "astro:components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Figure from "../components/Figure.astro";
import { config } from "virtual:nimbus/config";
import {
  HOME_TITLE,
  hero,
  step,
  stepSection,
  roles,
  partitionSection,
  primitives,
  doorsSection,
  doors,
  dashboardSection,
  proofSection,
  proof,
  runSection,
  differentiators,
  limits,
  start,
} from "../lib/home";

/**
 * The landing page. Every word on it comes from src/lib/home.ts, which the
 * markdown twin (index.md.ts) reads too. Elements marked `data-md` are the
 * ones scripts/check-markdown.mjs looks for in dist/index.md.
 *
 * The rhythm: a split hero, then sections that alternate between the page and
 * a card-coloured band, each with a small label, a title, one lead paragraph,
 * and one piece of evidence (code, a drawn figure, a chart, a screenshot) that
 * shows what the paragraph claims.
 */

// The same pair Nimbus configures for MDX code blocks, with defaultColor off:
// each span carries the light colour plus a `--shiki-dark` custom property,
// and globals.css flips it under [data-mode="dark"].
const SHIKI = { light: "github-light", dark: "github-dark" } as const;

const eyebrow = "text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-muted-foreground";
const h2 = "mt-3 text-2xl font-semibold tracking-tight text-foreground lg:text-[1.875rem] lg:leading-[1.15]";
const lead = "mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground";
const card =
  "block rounded-xl border border-border bg-background p-5 no-underline transition-colors hover:border-border-strong";
---

<BaseLayout title={HOME_TITLE} description={config.description}>
  <div class="flex min-h-screen flex-col">
    <Header transparentTop showSidebar={false} />

    <main class="w-full flex-1">
      {/* Hero: full height, two halves from lg up; the scene fills the right
          42% under the clear header. Below lg the scene sits under the text. */}
      <section class="lg:-mt-[calc(3.5rem+1px)] lg:grid lg:min-h-svh lg:grid-cols-[minmax(0,1fr)_42%]">
        <div class="flex lg:items-center lg:justify-center lg:px-16 xl:px-24">
          <div class="mx-auto w-full max-w-6xl px-6 pb-12 pt-12 lg:max-w-[30rem] lg:px-0 lg:py-24">
            <p class={eyebrow}>{hero.eyebrow}</p>
            <h1 data-md class="mt-5 text-foreground">
              <span
                class="block"
                style="font-size: clamp(2.25rem, 3.4vw, 3.125rem); line-height: 1.04; font-weight: var(--nb-h1-weight); letter-spacing: -0.035em;"
              >
                {hero.headline}
              </span>
              {" "}
              <span class="mt-4 block text-[1.125rem] font-medium leading-snug tracking-tight text-foreground/70 lg:text-[1.25rem]">
                {hero.subline}
              </span>
            </h1>
            <p data-md class="mt-6 text-[1.0625rem] leading-relaxed text-foreground/85">{hero.lead}</p>
            <p data-md class="mt-4 text-[0.9375rem] leading-relaxed text-muted-foreground">{hero.second}</p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href={hero.primary.href}
                class="rounded-lg bg-primary px-4 py-2 text-[0.8125rem] font-medium text-primary-foreground no-underline transition-colors hover:bg-primary-hover"
              >
                {hero.primary.label}
              </a>
              <a
                href={hero.secondary.href}
                class="rounded-lg border border-border px-4 py-2 text-[0.8125rem] font-medium text-foreground no-underline transition-colors hover:border-border-strong"
              >
                {hero.secondary.label}
              </a>
              <a
                href="https://github.com/queen-mq/queen"
                class="px-2 py-2 text-[0.8125rem] text-muted-foreground no-underline transition-colors hover:text-foreground"
              >
                GitHub →
              </a>
            </div>

            <div class="mt-8 rounded-lg border border-border bg-card px-4 py-3">
              <pre class="overflow-x-auto text-[0.75rem] leading-relaxed text-foreground"><code><span class="select-none text-muted-foreground">$ </span>{hero.run}</code></pre>
            </div>
            <p class="mt-3 text-[0.8125rem] text-muted-foreground">{hero.runNote}</p>
          </div>
        </div>

        <div class="relative aspect-[4/5] w-full sm:mx-auto sm:mb-12 sm:max-w-xl sm:overflow-hidden sm:rounded-xl lg:mx-0 lg:mb-0 lg:aspect-auto lg:max-w-none lg:rounded-none">
          <img
            src="/queen-scene-on-light.svg"
            alt=""
            width="1200"
            height="1536"
            class="hero-scene-light absolute inset-0 h-full w-full object-cover"
            style="object-position: 48% 50%;"
          />
          <img
            src="/queen-scene-on-dark.svg"
            alt=""
            width="1200"
            height="1536"
            class="hero-scene-dark absolute inset-0 h-full w-full object-cover"
            style="object-position: 48% 50%;"
          />
        </div>
      </section>

      {/* One step, one commit */}
      <section class="border-t border-border">
        <div class="mx-auto w-full max-w-5xl px-6 py-20 lg:px-10 lg:py-28">
          <p class={eyebrow}>{stepSection.eyebrow}</p>
          <h2 data-md class={h2}>{stepSection.title}</h2>
          <p data-md class={lead}>{stepSection.lead}</p>

          <div class="home-code mt-12 overflow-hidden rounded-xl border border-border bg-card">
            <div class="flex items-center justify-between border-b border-border px-5 py-2.5 text-xs text-muted-foreground">
              <span class="font-medium">One step, as one call</span>
              <span>JavaScript</span>
            </div>
            <div class="overflow-x-auto px-5 py-4 text-[0.75rem]">
              <Code code={step} lang="js" themes={SHIKI} defaultColor={false} />
            </div>
            <ol class="grid grid-cols-2 border-t border-border sm:grid-cols-3 lg:grid-cols-6">
              {
                roles.map((r) => (
                  <li class="border-b border-r border-border px-5 py-4 lg:border-b-0">
                    <a href={r.href} class="text-[0.875rem] font-medium text-foreground no-underline hover:underline">
                      {r.role}
                    </a>
                    <p data-md class="mt-1 text-[0.8125rem] leading-snug text-muted-foreground">{r.primitive}</p>
                  </li>
                ))
              }
              <li class="bg-background px-5 py-4">
                <span class="text-[0.875rem] font-medium text-foreground">One entry</span>
                <p class="mt-1 text-[0.8125rem] leading-snug text-muted-foreground">committed whole, or not at all</p>
              </li>
            </ol>
          </div>

          <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-center">
            <div class="lg:col-span-8">
              <Figure id="concepts/four-systems" />
            </div>
            <div class="lg:col-span-4">
              <p data-md class="text-[0.9375rem] leading-relaxed text-muted-foreground">{stepSection.after}</p>
              <a href={stepSection.link.href} class="mt-4 inline-block text-[0.8125rem] font-medium">
                {stepSection.link.label} →
              </a>
            </div>
          </div>
        </div>
      </section>

      {/* Partitions */}
      <section class="border-t border-border bg-card">
        <div class="mx-auto w-full max-w-5xl px-6 py-20 lg:px-10 lg:py-28">
          <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <p class={eyebrow}>{partitionSection.eyebrow}</p>
              <h2 data-md class={h2}>{partitionSection.title}</h2>
              <p data-md class="mt-4 text-base leading-relaxed text-muted-foreground">{partitionSection.lead}</p>
              <p data-md class="mt-4 text-[0.9375rem] leading-relaxed text-muted-foreground">{partitionSection.after}</p>
              <a href={partitionSection.link.href} class="mt-4 inline-block text-[0.8125rem] font-medium">
                {partitionSection.link.label} →
              </a>
            </div>
            <div class="lg:col-span-8 lg:pt-2">
              <Figure id="benchmarks/partitions-p99" />
            </div>
          </div>
        </div>
      </section>

      {/* Primitives */}
      <section class="border-t border-border">
        <div class="mx-auto w-full max-w-5xl px-6 py-20 lg:px-10 lg:py-28">
          <p class={eyebrow}>Everything in one log</p>
          <h2 class={h2}>The pieces a step needs, sharing one commit</h2>
          <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              primitives.map((p) => (
                <a href={p.href} class={card}>
                  <div class="text-[0.9375rem] font-medium text-foreground">{p.title}</div>
                  <p data-md class="mt-1.5 text-[0.8125rem] leading-relaxed text-muted-foreground">{p.body}</p>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      {/* Doors */}
      <section class="border-t border-border bg-card">
        <div class="mx-auto w-full max-w-5xl px-6 py-20 lg:px-10 lg:py-28">
          <p class={eyebrow}>{doorsSection.eyebrow}</p>
          <h2 data-md class={h2}>{doorsSection.title}</h2>
          <p data-md class={lead}>{doorsSection.lead}</p>

          <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-12">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:col-span-6">
              {
                doors.map((d, i) => (
                  <a href={d.href} class={i === doors.length - 1 && doors.length % 2 === 1 ? `${card} sm:col-span-2` : card}>
                    <div class="text-[0.9375rem] font-medium text-foreground">{d.title}</div>
                    <p data-md class="mt-1.5 text-[0.8125rem] leading-relaxed text-muted-foreground">{d.body}</p>
                  </a>
                ))
              }
            </div>
            <div class="home-code overflow-hidden rounded-xl border border-border bg-background lg:col-span-6 lg:self-start">
              <div class="border-b border-border px-4 py-2.5 text-xs font-medium text-muted-foreground">
                {doorsSection.snippetTitle}
              </div>
              <div class="overflow-x-auto px-5 py-4 text-[0.75rem]">
                <Code code={doorsSection.snippet} lang="bash" themes={SHIKI} defaultColor={false} />
              </div>
              <p class="border-t border-border px-4 py-3 text-[0.8125rem] text-muted-foreground">
                The source copies the rows already there, then streams every committed change. A
                sink is the same call with <code>"kind": "sink"</code>.
                <a href="/guides/postgres/"> PostgreSQL →</a>
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* Dashboard */}
      <section class="border-t border-border">
        <div class="mx-auto w-full max-w-5xl px-6 py-20 lg:px-10 lg:py-28">
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
            <div class="lg:col-span-7">
              <p class={eyebrow}>{dashboardSection.eyebrow}</p>
              <h2 data-md class={h2}>{dashboardSection.title}</h2>
            </div>
            <div class="lg:col-span-5">
              <p data-md class="text-[0.9375rem] leading-relaxed text-muted-foreground">{dashboardSection.lead}</p>
              <a href={dashboardSection.link.href} class="mt-3 inline-block text-[0.8125rem] font-medium">
                {dashboardSection.link.label} →
              </a>
            </div>
          </div>
          <div class="mt-12 overflow-hidden rounded-xl border border-border">
            {/* WebP at 2048 wide: twice the 1024px the frame reaches, so it stays
                sharp on a 2x screen at a quarter of the 2880px PNG's bytes. Only
                the visible one loads: a lazy image that is not rendered is not
                fetched. */}
            <img
              src={`/screenshots/${dashboardSection.image}-light.webp`}
              alt={dashboardSection.alt}
              width="2048"
              height="1280"
              loading="lazy"
              decoding="async"
              class="home-shot-light block h-auto w-full"
            />
            <img
              src={`/screenshots/${dashboardSection.image}-dark.webp`}
              alt={dashboardSection.alt}
              width="2048"
              height="1280"
              loading="lazy"
              decoding="async"
              class="home-shot-dark block h-auto w-full"
            />
          </div>
        </div>
      </section>

      {/* Proof */}
      <section class="border-t border-border bg-card">
        <div class="mx-auto w-full max-w-5xl px-6 py-20 lg:px-10 lg:py-28">
          <p class={eyebrow}>{proofSection.eyebrow}</p>
          <h2 data-md class={h2}>{proofSection.title}</h2>
          <p data-md class={lead}>{proofSection.lead}</p>
          <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
              proof.map((p) => (
                <a href={p.href} class={card}>
                  <div class="text-2xl font-semibold tracking-tight text-foreground">{p.figure}</div>
                  <div class="mt-1 text-[0.6875rem] uppercase tracking-wide text-muted-foreground">{p.unit}</div>
                  <p data-md class="mt-3 text-[0.8125rem] leading-relaxed text-muted-foreground">{p.body}</p>
                </a>
              ))
            }
          </div>
          <a href={proofSection.link.href} class="mt-8 inline-block text-[0.8125rem] font-medium">
            {proofSection.link.label} →
          </a>
        </div>
      </section>

      {/* Operations */}
      <section class="border-t border-border">
        <div class="mx-auto w-full max-w-5xl px-6 py-20 lg:px-10 lg:py-28">
          <p class={eyebrow}>{runSection.eyebrow}</p>
          <h2 class={h2}>{runSection.title}</h2>
          <div class="mt-12 grid grid-cols-1 gap-x-12 gap-y-10 sm:grid-cols-2">
            {
              differentiators.map((d) => (
                <div class="border-t border-border pt-5">
                  <h3 class="text-[0.9375rem] font-medium text-foreground">
                    <a href={d.href} class="no-underline">
                      {d.title}
                    </a>
                  </h3>
                  <p data-md class="mt-2 text-[0.9375rem] leading-relaxed text-muted-foreground">{d.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      {/* Limits */}
      <section class="border-t border-border bg-card">
        <div class="mx-auto w-full max-w-5xl px-6 py-12 lg:px-10 lg:py-14">
          <p data-md class="max-w-3xl text-[0.9375rem] leading-relaxed text-muted-foreground">
            {limits}
            <a href="/reference/limits/"> Read the full list before you design around it →</a>
          </p>
        </div>
      </section>

      {/* Start */}
      <section class="border-t border-border">
        <div class="mx-auto w-full max-w-5xl px-6 py-20 lg:px-10 lg:py-24">
          <h2 class="text-xl font-semibold tracking-tight text-foreground">Start here</h2>
          <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
              start.map((s) => (
                <a href={s.href} class={card}>
                  <div class="text-[0.9375rem] font-medium text-foreground">{s.title}</div>
                  <p class="mt-1 text-[0.8125rem] leading-relaxed text-muted-foreground">{s.body}</p>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <footer class="border-t border-border">
        <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-6 py-8 text-[0.8125rem] text-muted-foreground lg:px-10">
          <span>Apache 2.0</span>
          <a href="https://github.com/queen-mq/queen">GitHub</a>
          <a href="/reference/">Reference</a>
          <a href="/benchmarks/">Benchmarks</a>
          <a href="/reference/http/">HTTP API</a>
          <a href="/reference/changelog/">Changelog</a>
          <a href="/start/about/" class="ml-auto">Built at Smartness.</a>
        </div>
      </footer>
    </main>
  </div>
</BaseLayout>

<style>
  /* Code on this page sits in a card that already has a frame and a header:
     Shiki's own background, padding and border would be a box in a box. */
  .home-code :global(pre.astro-code) {
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent !important;
    /* the wrapper scrolls; a second scroller here showed an empty track */
    overflow: visible !important;
  }
  /* The hero scene and the dashboard screenshot exist once per theme.
     BaseLayout stamps data-mode="dark" on <html> for the dark theme only. */
  .hero-scene-dark,
  .home-shot-dark {
    display: none;
  }
  :global(:root[data-mode="dark"]) .hero-scene-light,
  :global(:root[data-mode="dark"]) .home-shot-light {
    display: none;
  }
  :global(:root[data-mode="dark"]) .hero-scene-dark,
  :global(:root[data-mode="dark"]) .home-shot-dark {
    display: block;
  }
</style>
