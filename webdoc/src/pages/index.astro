---
import { Code } from "astro:components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { config } from "virtual:nimbus/config";
import pushRaw from "../content/partials/snippets/js-push.mdx?raw";
import consumeRaw from "../content/partials/snippets/js-consume.mdx?raw";
import positionMapRaw from "../../../assets/queen-map.svg?raw";

/**
 * The landing page.
 *
 * The code samples are pulled out of the generated snippet partials rather than
 * retyped, so the front page cannot drift from the test suite either. Imported
 * `?raw` so Vite resolves them at build time and tracks them for hot reload.
 * Reading the file at runtime would look in the bundled output, not the source.
 * See webdoc/scripts/gen-snippets.mjs.
 */
function snippet(raw: string, id: string): string {
  const fenced = raw.match(/```[a-z]*[^\n]*\n([\s\S]*?)```/);
  if (!fenced) throw new Error(`snippet ${id} has no fenced block`);
  return fenced[1].trimEnd();
}

// The same pair Nimbus configures for MDX code blocks, with defaultColor off:
// each span then carries the light colour plus a `--shiki-dark` custom
// property, and globals.css flips it under [data-mode="dark"]. Using Astro's
// default here would give the landing page a second, mismatched code theme.
const SHIKI = { light: "github-light", dark: "github-dark" } as const;

/**
 * The `<title>` for this page. Deliberately not `config.title`: NimbusHead
 * appends " | Queen MQ" only when the page title differs from the site title,
 * so passing the site title emitted a bare `<title>Queen MQ</title>` on the one
 * page that most needs to say what this is. This renders as
 * "Postgres message queue with per-entity ordering | Queen MQ". Leave the
 * brand out of the string or it gets appended twice.
 */
const HOME_TITLE = "Postgres message queue with per-entity ordering";

const produce = snippet(pushRaw, "js-push");
const consume = snippet(consumeRaw, "js-consume");

/**
 * The figure is inlined rather than served through an `img`, and the same file
 * ships in the README. An `img` renders in its own document, so it cannot see
 * `data-mode` and would keep following the operating system while the reader
 * flips the site theme. Inlined, the stylesheet inside the file becomes part of
 * this page and the toggle drives it. The XML prolog has to go: it is legal in
 * a standalone SVG and a stray processing instruction inside HTML.
 */
const positionMap = positionMapRaw
  .replace(/^<\?xml[^>]*\?>\s*/, "")
  .replace(/<svg /, '<svg class="w-full h-auto" ');

// `href` is optional: only the cards whose subject has one obvious destination
// carry a link, so the linked ones stay meaningful rather than decorative.
const differentiators: { title: string; body: string; href?: string }[] = [
  {
    title: "One ordered lane per entity",
    body: "A partition is created on first push and costs index rows, not a commit-log file and not a process. A consumer stuck on one lane never blocks another.",
  },
  {
    title: "No rebalancing, because there is nothing to rebalance",
    body: "Broker and clients hold no coordination state, so scaling is starting another copy against the same database.",
  },
  {
    title: "PostgreSQL is the storage engine",
    body: "Durability, replication, backup and SQL introspection are the ones you already operate, not a second data system.",
  },
  {
    title: "Acknowledgement moves a cursor",
    body: "Ack a single message or a whole leased batch. Either way progress is one cursor per partition and consumer group, so there is no per-message delivery record to store, scan or clean up.",
    href: "/reference/http/ack/",
  },
  {
    title: "Ack the input and push the output in one commit",
    body: "One transaction acknowledges batches leased from any number of partitions and pushes to any number of queues. A pipeline stage cannot lose its input or duplicate its output.",
    href: "/reference/http/transaction/",
  },
  {
    title: "Key/value state and timers are part of the engine",
    body: "A key/value write can share the transaction with a push and an ack, and if your lease expired while the work ran, the ack is refused and the marker is refused with it. A compare-and-swap in a second store cannot do that: it succeeds from a worker that no longer owns the message. A timer is a scheduled message you can cancel and reprogram until it fires, which an append-only log cannot express. Neither is a flag you turn on: they are on every cell that runs the binary.",
    href: "/use/kv/",
  },
  {
    title: "Windowed aggregation, in the same transaction",
    body: "Tumbling, sliding, session and cron windows whose state, output and acks commit together or not at all: exactly-once, with no changelog topic and no state store.",
    href: "/use/streams/",
  },
  {
    title: "Exactly the semantics you already know",
    body: "Offsets, consumer groups and replay from Kafka; leases, retries and a dead-letter queue from RabbitMQ. Real pipelines need both.",
  },
  {
    title: "Plain HTTP, six SDKs, one binary",
    body: "No custom wire protocol, no JVM, no Erlang, no ZooKeeper. Anything that can make an HTTP request is a first-class client.",
  },
];

/**
 * The concession, and the reason it is on the front page rather than buried in
 * /start/compare.
 *
 * An application write that commits with the cursor advance is NOT new and is
 * available at least four other ways. The reader most likely to buy this is the
 * one who already knows that, so conceding it first is what keeps them reading:
 * copy that implied nobody else could do it lost exactly that reader, on a
 * claim we were never actually making. The differentiator is the price, so the
 * price is what this table is.
 *
 * Every row here is a system whose mechanism we are confident about. Azure
 * Service Bus (session state inside a namespace transaction) and Pulsar
 * (function state excluded from transactions) are deliberately absent: both are
 * plausible and neither is verified, and a wrong "closest competitor" claim on
 * a front page is the expensive kind.
 */
const alternatives: { system: string; cost: string; ours?: boolean }[] = [
  {
    system: "Kafka Streams",
    cost: "The stream processing model, state that is local to the partition, and a restore from the changelog on every rebalance.",
  },
  {
    system: "Transactional outbox",
    cost: "A relay process with its own failure modes, the latency between committing and emitting, and schema coupling between your database and your topics.",
  },
  {
    system: "Redis Streams",
    cost: "Every key involved in one hash slot, and a default fsync policy that loses up to a second of already committed work when the process dies.",
  },
  {
    system: "pgmq and friends",
    cost: "The atomicity for free, on a queue head that contends far below the throughput measured further down this page.",
  },
  {
    system: "Queen",
    cost: "A method call.",
    ours: true,
  },
];

const proof = [
  {
    figure: "86.4B",
    unit: "messages",
    body: "24 hours of continuous load at ~1M msg/s per side with explicit acknowledgement, 1,000 messages touched by an error, zero restarts, broker memory flat.",
    href: "/benchmarks/soak-24h",
  },
  {
    figure: "0",
    unit: "order violations",
    body: "1,000 partitions through a four-stage pipeline at 25k events/s: 88,503,408 messages verified, zero duplicates, zero gaps.",
    href: "/benchmarks/ordered-pipeline",
  },
  {
    figure: "1M",
    unit: "ordered partitions",
    body: "A million FIFO lanes in one PostgreSQL, none preallocated, created during the run at a thousand a second and drained with zero push, pop or ack errors.",
    href: "/benchmarks/cardinality-1m",
  },
];

const featureLine = [
  "Consumer groups",
  "Replay",
  "Dead-letter queue",
  "Exact deduplication",
  "Transactional handoff",
  "Key/value state",
  "Cancellable timers",
  "Windowed aggregation",
  "A dashboard in the binary",
];
---

<BaseLayout title={HOME_TITLE} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />

    <main class="flex-1 w-full">
      {/* Hero */}
      <section class="mx-auto max-w-5xl w-full px-6 pt-20 pb-16">
        <p class="text-sm font-medium text-muted-foreground">
          Queen MQ 1.0 · Apache 2.0
        </p>
        <h1
          class="mt-3 max-w-3xl text-foreground leading-[1.05]"
          style="font-size: clamp(2.25rem, 5vw, 3.5rem); font-weight: var(--nb-h1-weight); letter-spacing: -0.02em;"
        >
          The queue that doesn't fall apart at the far end of your workload.
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed">
          Every entity gets its own ordered FIFO lane, created on first push, so a slow consumer
          on one never stalls another. One stateless binary on the PostgreSQL you already run,
          measured at <strong>1,000,000 messages a second</strong> for 24 hours
          and at <strong>1,000,000 ordered partitions</strong> in one database.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href="/start/quickstart"
            class="rounded-lg bg-foreground px-5 py-2.5 text-sm font-medium text-background no-underline transition-opacity hover:opacity-90"
          >
            Push your first message
          </a>
          <a
            href="/start/"
            class="rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-foreground no-underline transition-colors hover:border-border-strong"
          >
            Why it exists
          </a>
          <a
            href="/start/compare/"
            class="rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-foreground no-underline transition-colors hover:border-border-strong"
          >
            Compared to Kafka and RabbitMQ
          </a>
          <a
            href="https://github.com/queen-mq/queen"
            class="px-2 py-2.5 text-sm text-muted-foreground no-underline transition-colors hover:text-foreground"
          >
            Source on GitHub →
          </a>
        </div>

        <p class="mt-8 text-sm text-muted-foreground">
          {featureLine.join(" · ")}
        </p>
      </section>

      {/* The README intro, verbatim. Duplicated in index.md.ts (homepageBody),
          like the rest of this page's copy: edit both together. */}
      <section class="mx-auto max-w-5xl w-full px-6 pb-16">
        <p class="max-w-2xl text-muted-foreground leading-relaxed">
          Queen is a message broker written in Rust that uses PostgreSQL as its data store. Its
          main idea is to let you have an arbitrarily large number of FIFO partitions, created on
          demand at push time.
        </p>
        <p class="mt-4 text-foreground font-medium">Queen has:</p>
        <ul class="mt-3 grid gap-x-8 gap-y-1.5 sm:grid-cols-2 text-sm text-muted-foreground leading-relaxed list-disc pl-5">
          <li><strong class="text-foreground">High throughput</strong> (1 million msg/s end to end on 200 partitions, verified in a 24-hour soak)</li>
          <li><strong class="text-foreground">High dynamic cardinality</strong> (1 million partitions at 200k msg/s, verified end to end)</li>
          <li><strong class="text-foreground">Guaranteed order</strong> within every partition</li>
          <li><strong class="text-foreground">Easy HTTP transport</strong>: curl is a first-class client</li>
          <li><strong class="text-foreground">Transactional dedup at push</strong>: part of the exactly-once guarantees on broker operations</li>
          <li><strong class="text-foreground">Transactional ack+KV+push</strong>: the rest of the exactly-once guarantees</li>
          <li><strong class="text-foreground">KV</strong>: a small but powerful key-value store alongside your queue operations</li>
          <li><strong class="text-foreground">Timers</strong>: schedule messages ahead of time</li>
          <li><strong class="text-foreground">Consumer groups</strong> with replay and seek</li>
          <li><strong class="text-foreground">DLQ</strong>: no message lost, even in the worst cases</li>
          <li><strong class="text-foreground">Integrated stream processor</strong>: three window types, with map and aggregation</li>
          <li><strong class="text-foreground">Conflation, window buffers, delayed delivery</strong></li>
          <li><strong class="text-foreground">HA</strong>: multiple brokers with best-effort coordination and wake-ups on push and ack</li>
          <li><strong class="text-foreground">Durable by default, with synchronous commit</strong>: not losing data is the whole point of Queen</li>
          <li><strong class="text-foreground">Ephemeral in-memory queues</strong> for lighter jobs like signaling and request/reply</li>
          <li><strong class="text-foreground">Multi-tenant</strong> with quotas, through the bundled Rust proxy</li>
          <li><strong class="text-foreground">Single binary</strong></li>
        </ul>
        <p class="mt-4 max-w-2xl text-muted-foreground leading-relaxed">
          As far as we know, nothing else out there has all of this in one system. If you use
          Queen, you can offload to it a ton of logic you would otherwise have to write yourself.
        </p>
      </section>

      {/* Where it sits */}
      <section class="mx-auto max-w-5xl w-full px-6 pb-16">
        <div class="rounded-xl border border-border bg-card p-4 sm:p-6 overflow-x-auto">
          {/* Below roughly 720px the figure would set its 12px labels at four
              or five CSS pixels, so it scrolls instead of shrinking. */}
          <div class="min-w-[720px]">
            <Fragment set:html={positionMap} />
          </div>
        </div>
        <p class="mt-3 text-sm text-muted-foreground">
          Each frontier is where a system stops keeping one ordered lane per entity: measured
          on matched hardware for Kafka, RabbitMQ and pgmq, taken from the published quotas
          for SQS, and dashed wherever the edge is one we did not measure. Queen's region is a
          square because the axes share a scale and it reaches a million on both, in two
          separate runs. The conditions behind every figure are in
          <a href="/start/compare/">the comparison</a> and in <a href="/benchmarks/comparison">the measured runs</a>.
        </p>
      </section>

      {/* Code */}
      <section class="mx-auto max-w-5xl w-full px-6 pb-20">
        <h2 class="text-xl font-semibold text-foreground">It looks like this</h2>
        <p class="mt-2 max-w-2xl text-muted-foreground leading-relaxed">
          Queues and partitions are created on first use, so there is nothing to provision
          before the first line runs.
        </p>

        <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
          <div class="rounded-lg border border-border overflow-hidden">
            <div class="border-b border-border px-4 py-2 text-xs font-medium text-muted-foreground">
              Produce
            </div>
            <div class="p-4 text-sm overflow-x-auto">
              <Code code={produce} lang="js" themes={SHIKI} defaultColor={false} />
            </div>
          </div>
          <div class="rounded-lg border border-border overflow-hidden">
            <div class="border-b border-border px-4 py-2 text-xs font-medium text-muted-foreground">
              Consume
            </div>
            <div class="p-4 text-sm overflow-x-auto">
              <Code code={consume} lang="js" themes={SHIKI} defaultColor={false} />
            </div>
          </div>
        </div>

        <p class="mt-3 text-sm text-muted-foreground">
          There are <a href="/use/js-client">SDKs for JavaScript, Python, Go, Rust, PHP and C++</a>, <a href="/reference/queenctl/">an operator CLI</a>, and a <a href="/reference/http">plain HTTP API</a> for everything else.
        </p>
      </section>

      {/* Differentiators */}
      <section class="border-t border-border">
        <div class="mx-auto max-w-5xl w-full px-6 py-16">
          <h2 class="text-xl font-semibold text-foreground">What makes it different</h2>
          <div class="mt-8 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2">
            {
              differentiators.map((d) => (
                <div>
                  <h3 class="font-medium text-foreground">
                    {d.href ? <a href={d.href}>{d.title}</a> : d.title}
                  </h3>
                  <p class="mt-1.5 text-sm text-muted-foreground leading-relaxed">{d.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      {/* The concession */}
      <section class="border-t border-border">
        <div class="mx-auto max-w-5xl w-full px-6 py-16">
          <h2 class="text-xl font-semibold text-foreground">
            You can already buy this. Here is what it costs.
          </h2>
          <p class="mt-2 max-w-2xl text-muted-foreground leading-relaxed">
            A consumer charges a card and is still writing its done flag to a side store when its
            lease expires. The broker gives the batch to somebody else, and somebody else finds no
            flag. An application write that commits with the cursor advance is what closes that
            window, and nothing about it is new: it is available today, four other ways, and every
            one of them is priced.
          </p>

          <dl class="mt-8 divide-y divide-border border-y border-border">
            {
              alternatives.map((a) => (
                <div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-[13rem_1fr] sm:gap-6">
                  <dt class={a.ours ? "font-semibold text-foreground" : "font-medium text-foreground"}>
                    {a.system}
                  </dt>
                  <dd
                    class={
                      a.ours
                        ? "text-sm font-medium text-foreground leading-relaxed"
                        : "text-sm text-muted-foreground leading-relaxed"
                    }
                  >
                    {a.cost}
                  </dd>
                </div>
              ))
            }
          </dl>

          <p class="mt-6 max-w-3xl text-sm text-muted-foreground leading-relaxed">
            None of these is exactly-once end to end, and neither is Queen. The card charge happens
            outside PostgreSQL, so a crash between the charge and the commit repeats the charge on
            redelivery, and no broker can prevent that. What a shared commit removes is the state in
            between: the work marked done while the message comes back anyway, or the message
            acknowledged while the work is left unmarked. With two commits, whichever order you
            pick, a crash inside the window gives you one of those two.
            <a href="/use/kv/"> How the marker, the output and the cursor commit together →</a>
          </p>
        </div>
      </section>

      {/* Dashboard */}
      <section class="border-t border-border">
        <div class="mx-auto max-w-5xl w-full px-6 py-16">
          <h2 class="text-xl font-semibold text-foreground">
            <a href="/deploy/dashboard/" class="no-underline text-foreground">The dashboard is already in there</a>
          </h2>
          <p class="mt-2 max-w-2xl text-muted-foreground leading-relaxed">
            Queue health, per-group lag, message inspection and dead-letter replay. Nothing was
            installed to get this: it is the same binary, on the port you already opened, and it
            grows logins and roles when it runs <a href="/deploy/multi-tenant/">behind the proxy</a>.
          </p>
          <img
            src="/screenshots/dashboard-overview.png"
            alt="The bundled dashboard's overview: stored messages, queues, partitions, consumer groups, pending and completed counts above a table of throughput, lag and error series with sparklines."
            width="2880"
            height="1800"
            loading="lazy"
            class="mt-6 w-full h-auto rounded-xl border border-border"
          />
        </div>
      </section>

      {/* Proof */}
      <section class="border-t border-border">
        <div class="mx-auto max-w-5xl w-full px-6 py-16">
          <h2 class="text-xl font-semibold text-foreground">Measured, with the conditions attached</h2>
          <p class="mt-2 max-w-2xl text-muted-foreground leading-relaxed">
            Every number on this site names the run that produced it. A figure without an
            archived artifact recording its configuration does not get published here.
          </p>

          <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
            {
              proof.map((p) => (
                <a
                  href={p.href}
                  class="block rounded-lg border border-border p-5 no-underline transition-colors hover:border-border-strong"
                >
                  <div class="text-3xl font-semibold text-foreground">{p.figure}</div>
                  <div class="mt-0.5 text-xs uppercase tracking-wide text-muted-foreground">
                    {p.unit}
                  </div>
                  <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{p.body}</p>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      {/* Limits */}
      <section class="border-t border-border">
        <div class="mx-auto max-w-5xl w-full px-6 py-10">
          <p class="max-w-3xl text-sm text-muted-foreground leading-relaxed">
            Queen has real limits: in-group parallelism is bounded by how many distinct entities
            you push to, because exactly one leased batch is in flight per partition and consumer
            group, and one PostgreSQL is both the ceiling and the failure domain. Ordering is per
            entity, and how coarse or fine that is comes from your partition key rather than from
            a number fixed when the queue was created.
            <a href="/reference/limits"> Read the full list before you design around it →</a>
          </p>
        </div>
      </section>

      {/* Start */}
      <section class="border-t border-border">
        <div class="mx-auto max-w-5xl w-full px-6 py-16">
          <h2 class="text-xl font-semibold text-foreground">Start</h2>
          <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <a
              href="/start/quickstart"
              class="block rounded-lg border border-border p-5 no-underline transition-colors hover:border-border-strong"
            >
              <div class="font-medium text-foreground">Use it</div>
              <p class="mt-1 text-sm text-muted-foreground leading-relaxed">
                The model in one page, the SDKs, and worked examples.
              </p>
            </a>
            <a
              href="/use/js-client"
              class="block rounded-lg border border-border p-5 no-underline transition-colors hover:border-border-strong"
            >
              <div class="font-medium text-foreground">Pick your SDK</div>
              <p class="mt-1 text-sm text-muted-foreground leading-relaxed">
                JavaScript, Python, Go, Rust, PHP and C++, plus queenctl and plain HTTP.
              </p>
            </a>
            <a
              href="/deploy"
              class="block rounded-lg border border-border p-5 no-underline transition-colors hover:border-border-strong"
            >
              <div class="font-medium text-foreground">Host it</div>
              <p class="mt-1 text-sm text-muted-foreground leading-relaxed">
                Deployment, PostgreSQL, high availability, security, operations.
              </p>
            </a>
            <a
              href="/internals"
              class="block rounded-lg border border-border p-5 no-underline transition-colors hover:border-border-strong"
            >
              <div class="font-medium text-foreground">Understand it</div>
              <p class="mt-1 text-sm text-muted-foreground leading-relaxed">
                Segments, offsets, the push and pop paths, the schema underneath.
              </p>
            </a>
          </div>
        </div>
      </section>

      <footer class="border-t border-border">
        <div
          class="mx-auto max-w-5xl w-full px-6 py-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted-foreground"
        >
          <span>Apache 2.0</span>
          <a href="https://github.com/queen-mq/queen">GitHub</a>
          <a href="/reference">Reference</a>
          <a href="/benchmarks">Benchmarks</a>
          <a href="/reference/openapi">OpenAPI</a>
          <span class="ml-auto">Built at Smartness.</span>
        </div>
      </footer>
    </main>
  </div>
</BaseLayout>
