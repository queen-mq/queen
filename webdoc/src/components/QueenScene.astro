---
import scene from "../../public/queen-scene-on-light.svg?raw";
---

<queen-scene class="queen-scene" data-camera-view="auto">
  <div class="scene-art" set:html={scene} />
  <div class="scene-caption">
    <section class="partition-detail" aria-label="Example partition contents" hidden>
      <div class="detail-heading">
        <div><span class="detail-eyebrow">Inside the partition</span><strong data-partition-name>orders / customer-42</strong></div>
        <span class="detail-state" data-consume-state>Batch leased</span>
      </div>
      <div class="message-stream" role="group" aria-label="Retained messages; select one to inspect">
        {Array.from({ length: 6 }, (_, i) => (
          <button type="button" data-message={i} aria-pressed={i === 1 ? "true" : "false"}>
            <span class="message-offset">#{41 + i}</span>
            <span class="message-kind">{["done", "created", "paid", "confirm", "created", "paid"][i]}</span>
          </button>
        ))}
      </div>
      <div class="cursor-track" aria-hidden="true"><span class="cursor-marker">▲</span></div>
      <div class="stream-context"><span data-cursor-label>billing · cursor #41</span><span>Messages retained</span></div>
      <div class="example-payload"><span>Example payload</span><code data-payload></code></div>
    </section>
    <span>One queue. Many partitions.</span>
  </div>
  <div class="scene-controls">
    <button data-animation-toggle type="button" aria-label="Pause bee animation" aria-pressed="false" hidden>
      <svg class="pause-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <rect x="4" y="3" width="3" height="10" rx="1" />
        <rect x="9" y="3" width="3" height="10" rx="1" />
      </svg>
      <svg class="play-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M5 3 L12 8 L5 13 Z" />
      </svg>
      <span class="animation-label" aria-hidden="true">Pause animation</span>
    </button>
    <button type="button" data-zoom-menu aria-label="Zoom controls" title="Zoom controls" aria-expanded="false" aria-controls="queen-zoom-options">
      <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="8.5" cy="8.5" r="5.5" /><path d="M13 13 L17 17 M6 8.5 H11 M8.5 6 V11" stroke-linecap="round" />
      </svg>
    </button>
    <div id="queen-zoom-options" class="view-controls" role="group" aria-label="Illustration zoom">
      <button type="button" data-view="auto" aria-pressed="true" aria-label="Automatic zoom">Auto</button>
      <button type="button" data-view="detail" aria-pressed="false" aria-label="Show partition detail">Detail</button>
      <button type="button" data-view="full" aria-pressed="false" aria-label="Show whole sunflower">Full view</button>
    </div>
  </div>
</queen-scene>

<script>
  class QueenScene extends HTMLElement {
    private observer?: IntersectionObserver;
    private reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    private userPaused = this.reducedMotion.matches;
    private visible = true;
    private detailTimer?: ReturnType<typeof setInterval>;
    private selectedMessage?: number;
    private visitIndex = -1;
    private detailState = "";

    private updateDetail = () => {
      const time = this.querySelector(".consumer-flight")?.getAnimations()[0]?.currentTime;
      const elapsed = typeof time === "number" ? time % 18000 : 0;
      const index = Math.floor(elapsed / 6000);
      const localTime = elapsed % 6000;
      const visit = this.querySelectorAll<SVGGElement>(".partition-visit")[index];
      if (!visit) return;
      if (index !== this.visitIndex) {
        this.selectedMessage = undefined;
        this.visitIndex = index;
      }
      const showDetail = this.dataset.cameraView === "detail" ||
        (this.dataset.cameraView === "auto" && elapsed >= 1800 && elapsed < 16500);
      this.toggleAttribute("data-detail-visible", showDetail);
      const panel = this.querySelector<HTMLElement>(".partition-detail");
      if (panel) panel.hidden = !showDetail;
      const acked = localTime >= 3420;
      const processing = localTime >= 1800 && !acked;
      const selected = this.selectedMessage ?? (acked ? 3 : processing ? Math.min(3, 1 + Math.floor((localTime - 1800) / 540)) : 1);
      const key = `${index}:${acked}:${processing}:${selected}`;
      if (key === this.detailState) return;
      this.detailState = key;
      const partition = visit.dataset.partitionKey ?? "customer-42";
      const firstOffset = Number(visit.dataset.firstOffset);
      const events = ["order.completed", "order.created", "payment.received", "order.confirmed", "order.created", "payment.received"];
      const write = (selector: string, value: string) => {
        const element = this.querySelector(selector);
        if (element) element.textContent = value;
      };
      write("[data-partition-name]", `orders / ${partition}`);
      write("[data-consume-state]", acked ? "Ack committed" : processing ? "Processing" : "Batch leased");
      write("[data-cursor-label]", `billing · cursor #${acked ? firstOffset + 2 : firstOffset - 1}`);
      panel?.style.setProperty("--cursor-column", acked ? "4" : "1");
      panel?.setAttribute("data-acked", String(acked));
      this.querySelectorAll<HTMLButtonElement>("[data-message]").forEach((button, i) => {
        const offset = firstOffset - 1 + i;
        button.setAttribute("aria-pressed", String(i === selected));
        button.setAttribute("aria-label", `Inspect offset ${offset}: ${events[i]}`);
        button.dataset.state = i === 0 || (acked && i <= 3) ? "acked" : i <= 3 ? "leased" : "pending";
        const label = button.querySelector(".message-offset");
        if (label) label.textContent = `#${offset}`;
      });
      const orderId = selected === 0 ? 9136 : selected >= 4 ? 9138 : 9137;
      write("[data-payload]", JSON.stringify({ event: events[selected], orderId, customerId: partition.replace("customer-", "") }, null, 2));
    };

    private sync = () => {
      this.toggleAttribute(
        "data-animation-paused",
        this.userPaused || !this.visible || document.hidden,
      );
      this.toggleAttribute("data-animation-enabled", !this.userPaused);
      this.updateDetail();
      const paused = this.hasAttribute("data-animation-paused");
      if (paused && this.detailTimer) {
        clearInterval(this.detailTimer);
        this.detailTimer = undefined;
      } else if (!paused && !this.detailTimer) {
        this.detailTimer = setInterval(this.updateDetail, 100);
      }
      const button = this.querySelector<HTMLButtonElement>("[data-animation-toggle]");
      if (!button) return;
      button.hidden = false;
      button.setAttribute("aria-pressed", String(this.userPaused));
      button.setAttribute("aria-label", this.userPaused ? "Resume bee animation" : "Pause bee animation");
      button.title = this.userPaused ? "Play animation" : "Pause animation";
      const label = button.querySelector(".animation-label");
      if (label) label.textContent = this.userPaused ? "Play animation" : "Pause animation";
    };

    private onMotionChange = () => {
      this.userPaused = this.reducedMotion.matches;
      this.sync();
    };

    private toggle = () => {
      this.userPaused = !this.userPaused;
      this.sync();
    };

    private changeView = (event: Event) => {
      const element = event.target instanceof Element ? event.target : null;
      if (element?.closest("[data-zoom-menu]")) {
        const open = !this.hasAttribute("data-zoom-open");
        this.toggleAttribute("data-zoom-open", open);
        this.querySelector("[data-zoom-menu]")?.setAttribute("aria-expanded", String(open));
        return;
      }
      const message = element?.closest<HTMLButtonElement>("button[data-message]");
      if (message) {
        this.selectedMessage = Number(message.dataset.message);
        this.userPaused = true;
        this.sync();
        return;
      }
      const target = element?.closest<HTMLButtonElement>("button[data-view]");
      if (!target) return;
      this.dataset.cameraView = target.dataset.view;
      this.querySelectorAll<HTMLButtonElement>("button[data-view]").forEach(button => {
        button.setAttribute("aria-pressed", String(button === target));
      });
      this.closeZoom();
      this.updateDetail();
    };

    private closeZoom = () => {
      this.removeAttribute("data-zoom-open");
      this.querySelector("[data-zoom-menu]")?.setAttribute("aria-expanded", "false");
    };

    private dismissZoom = (event: Event) => {
      if (event instanceof KeyboardEvent && event.key === "Escape" && this.hasAttribute("data-zoom-open")) {
        this.closeZoom();
        this.querySelector<HTMLButtonElement>("[data-zoom-menu]")?.focus();
      } else if (event.type === "pointerdown" && event.target instanceof Element && !this.querySelector(".scene-controls")?.contains(event.target)) {
        this.closeZoom();
      }
    };

    connectedCallback() {
      this.querySelector("[data-animation-toggle]")?.addEventListener("click", this.toggle);
      this.addEventListener("click", this.changeView);
      document.addEventListener("pointerdown", this.dismissZoom);
      this.addEventListener("keydown", this.dismissZoom);
      document.addEventListener("visibilitychange", this.sync);
      this.reducedMotion.addEventListener("change", this.onMotionChange);
      this.observer = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        this.sync();
      });
      this.observer.observe(this);
      this.sync();
    }

    disconnectedCallback() {
      clearInterval(this.detailTimer);
      this.detailTimer = undefined;
      this.observer?.disconnect();
      this.querySelector("[data-animation-toggle]")?.removeEventListener("click", this.toggle);
      this.removeEventListener("click", this.changeView);
      document.removeEventListener("pointerdown", this.dismissZoom);
      this.removeEventListener("keydown", this.dismissZoom);
      document.removeEventListener("visibilitychange", this.sync);
      this.reducedMotion.removeEventListener("change", this.onMotionChange);
    }
  }

  if (!customElements.get("queen-scene")) customElements.define("queen-scene", QueenScene);
</script>

<style>
  .queen-scene {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .scene-art {
    display: flex;
    height: 100%;
    align-items: flex-end;
  }
  .scene-art :global(svg.queen-illustration) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .scene-caption {
    position: absolute;
    left: 5.5%;
    right: 5.5%;
    bottom: 5rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    color: var(--nb-muted-foreground);
    font-family: var(--nb-font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.03em;
  }
  button {
    display: flex;
    gap: 0.375rem;
    padding: 0 0.625rem;
    height: 2rem;
    align-items: center;
    border: 1px solid var(--nb-border);
    border-radius: 1rem;
    background: var(--nb-background);
    color: var(--nb-muted-foreground);
    cursor: pointer;
  }
  .scene-controls {
    position: absolute;
    right: 5.5%;
    bottom: 1.25rem;
    display: flex;
    gap: 0.375rem;
    opacity: 0.5;
    transition: opacity 0.2s;
  }
  .scene-controls:hover, .scene-controls:focus-within, :global(queen-scene[data-zoom-open]) .scene-controls {
    opacity: 1;
  }
  .scene-controls > button {
    width: 2rem;
    padding: 0;
    justify-content: center;
    background: var(--nb-background);
  }
  .animation-label { display: none; }
  .view-controls {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.5rem);
    display: none;
    white-space: nowrap;
  }
  :global(queen-scene[data-zoom-open]) .view-controls {
    display: flex;
  }
  .view-controls {
    padding: 2px;
    border: 1px solid var(--nb-border);
    border-radius: 1rem;
    background: var(--nb-background);
  }
  .view-controls button {
    height: calc(2rem - 6px);
    border: 0;
  }
  .view-controls button[aria-pressed="true"] {
    color: var(--nb-foreground);
    background: var(--nb-accent);
  }
  .partition-detail {
    --cursor-column: 1;
    padding: 1rem;
    border: 1px solid var(--nb-border);
    border-radius: 1rem;
    background: var(--nb-card);
    color: var(--nb-foreground);
    letter-spacing: 0;
    box-shadow: 0 8px 32px color-mix(in srgb, var(--nb-foreground) 5%, transparent);
  }
  .partition-detail[hidden], :global(queen-scene[data-detail-visible]) .scene-caption > span {
    display: none;
  }
  .detail-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
  }
  .detail-eyebrow {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--nb-muted-foreground);
  }
  .detail-heading strong { font-size: 0.6875rem; font-weight: 500; }
  .detail-state {
    flex-shrink: 0;
    padding: 0.25rem 0.4rem;
    border-radius: 0.375rem;
    background: var(--nb-brand);
    color: #1f1d1a;
    font-size: 0.5625rem;
  }
  .message-stream, .cursor-track {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.3rem;
  }
  .message-stream button {
    height: 2.75rem;
    padding: 0.25rem 0;
    flex-direction: column;
    justify-content: center;
    gap: 0.2rem;
    border-radius: 0.375rem;
  }
  .message-stream button[data-state="leased"] {
    border-color: var(--nb-brand);
    background: var(--nb-selected);
    color: var(--nb-foreground);
  }
  .message-stream button[aria-pressed="true"] {
    outline: 2px solid var(--nb-foreground);
    outline-offset: 1px;
  }
  .message-offset { font-size: 0.6875rem; }
  .message-kind { font-size: 0.5rem; }
  .cursor-marker { grid-column: var(--cursor-column); text-align: center; line-height: 1.25; }
  .stream-context {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.5625rem;
    color: var(--nb-muted-foreground);
  }
  .example-payload {
    margin-top: 0.75rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--nb-border);
  }
  .example-payload > span { font-size: 0.5625rem; color: var(--nb-muted-foreground); }
  .example-payload code {
    display: block;
    margin-top: 0.375rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-family: inherit;
    font-size: 0.625rem;
    line-height: 1.5;
  }
  @media (max-width: 380px) {
    .partition-detail { padding: 0.75rem; }
    .detail-heading { align-items: flex-start; }
    .detail-heading strong { font-size: 0.625rem; }
    .detail-state { font-size: 0.5rem; }
  }
  button:hover {
    border-color: var(--nb-foreground);
    color: var(--nb-foreground);
  }
  button:focus-visible {
    outline: 2px solid var(--nb-ring);
    outline-offset: 4px;
  }
  button[hidden], .play-icon, button[aria-pressed="true"] .pause-icon {
    display: none;
  }
  button[aria-pressed="true"] .play-icon {
    display: block;
  }
</style>
