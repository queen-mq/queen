<script>
  /**
   * The map's behaviour. Nothing here is needed to read the page: without it the
   * page's markdown twin says everything.
   *
   * Three states. `hovered`: the dot or box under the pointer (or the keyboard
   * focus); it is highlighted where it stands, and its line shows in a tooltip
   * (with the sidebar, in the sidebar while nothing is clicked); leave it and
   * the map is as before. `pinned`: what a
   * click, a goal or the URL's #fragment chose; the overlay shows it, on the side
   * of the screen away from it (a goal: the side that hides fewest of its
   * numbers), and ← → walk a part's dots. `found`: what the find field matches;
   * those dots light and the others step back, as for a goal. A click on the
   * empty map, the overlay's close button or Escape unpins.
   */
  import { onShortcut, syncShortcutHints } from "@cloudflare/nimbus-docs/client";

  interface Data {
    entries: Record<
      string,
      { core: string; label: string; line: string; isCore: boolean; since: string | null; find: string; aka: [string, string][] }
    >;
    cores: Record<string, { label: string; items: string[] }>;
    goals: Record<string, { label: string; lights: string[]; href: string }>;
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-qm]")) init(root);

  function init(root: HTMLElement): void {
    const data = JSON.parse(root.dataset.qmData ?? "{}") as Data;
    const svg = root.querySelector<SVGSVGElement>("[data-qm-svg]");
    const canvas = root.querySelector<HTMLElement>("[data-qm-canvas]");
    const tip = root.querySelector<HTMLElement>("[data-qm-tip]");
    const overlay = root.querySelector<HTMLElement>("[data-qm-overlay]");
    const overlayBody = root.querySelector<HTMLElement>("[data-qm-overlay-body]");
    const close = root.querySelector<HTMLButtonElement>("[data-qm-close]");
    const stage = root.querySelector<HTMLElement>("[data-qm-stage]");
    const findBox = root.querySelector<HTMLElement>("[data-qm-find]");
    const findInput = root.querySelector<HTMLInputElement>("[data-qm-find-input]");
    const findN = root.querySelector<HTMLElement>("[data-qm-find-n]");
    const findWhy = root.querySelector<HTMLElement>("[data-qm-find-why]");
    if (!svg || !canvas || !tip || !overlay || !overlayBody || !close || !stage || !findBox || !findInput || !findN || !findWhy) return;

    const nodes = new Map<string, SVGGElement>();
    for (const n of svg.querySelectorAll<SVGGElement>("[data-id]")) nodes.set(n.dataset.id!, n);
    const goalButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-goal]")];
    const stepGroups = [...svg.querySelectorAll<SVGGElement>("[data-steps]")];

    let pinned: string | null = null;
    let hovered: string | null = null;
    let found: Set<string> | null = null;

    const known = (key: string | null): key is string => !!key && (key in data.entries || key in data.goals);

    /** What a key lights: an entry and its box (a box: all its dots); a goal: its pieces and their boxes. */
    function lit(key: string | null): { ids: Set<string>; tx: boolean } {
      const ids = new Set<string>();
      if (!known(key)) return { ids, tx: false };
      const goal = data.goals[key];
      if (goal) {
        for (const id of goal.lights) {
          ids.add(id);
          ids.add(data.entries[id].core);
        }
        return { ids, tx: goal.lights.includes("transaction") };
      }
      const e = data.entries[key];
      ids.add(key);
      ids.add(e.core);
      if (e.isCore) for (const id of data.cores[key].items) ids.add(id);
      return { ids, tx: e.core === "transaction" };
    }

    /** What the find field lights: the dots and parts it matched, and the dots' parts. */
    function litFound(hits: Set<string>): { ids: Set<string>; tx: boolean } {
      const ids = new Set<string>();
      for (const id of hits) {
        ids.add(id);
        ids.add(data.entries[id].core);
      }
      return { ids, tx: false };
    }

    /**
     * Only a goal or the find field dims the map, to show some pieces together. A
     * box or a dot, hovered or clicked, is highlighted where it stands: its ring,
     * its bold name, its line; a box also brightens the lines to its dots, and the
     * transaction its own lines.
     */
    function paint(): void {
      const goal = !found && pinned && pinned in data.goals ? pinned : null;
      const { ids, tx } = found ? litFound(found) : lit(goal);
      svg!.classList.toggle("qm-focus", !!found || ids.size > 0);
      for (const g of stepGroups) g.classList.toggle("qm-on", g.dataset.steps === goal);
      svg!.classList.toggle("qm-tx-on", tx || pinned === "transaction" || hovered === "transaction");
      for (const [id, n] of nodes) {
        const e = data.entries[id];
        n.classList.toggle("qm-on", ids.has(id));
        n.classList.toggle("qm-picked", id === pinned);
        n.classList.toggle("qm-hover", id === hovered);
        n.classList.toggle("qm-fan-lit", !!e && !e.isCore && (e.core === hovered || e.core === pinned));
        n.classList.toggle("qm-found", !!found?.has(id));
      }
      for (const b of goalButtons) b.setAttribute("aria-pressed", String(b.dataset.goal === pinned));
    }

    function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string): HTMLElementTagNameMap[K] {
      const e = document.createElement(tag);
      e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    }

    function jump(key: string, label: string, cls = "qm-chip"): HTMLButtonElement {
      const b = el("button", cls, label);
      b.type = "button";
      b.addEventListener("click", () => pin(key));
      return b;
    }

    const ICON_PREV = `<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5L5.5 8L10 12.5"/></svg>`;
    const ICON_NEXT = `<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5L10.5 8L6 12.5"/></svg>`;
    const ICON_LINK =
      `<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 9.5l3-3"/>` +
      `<path d="M7.5 4.5l1-1a2.83 2.83 0 0 1 4 4l-1 1"/><path d="M8.5 11.5l-1 1a2.83 2.83 0 0 1-4-4l1-1"/></svg>`;

    /** "2 of 11" with the arrows to the dot before and after, in its part. */
    function navOf(key: string, items: string[]): HTMLElement {
      const i = items.indexOf(key);
      const n = items.length;
      const nav = el("div", "qm-nav");
      const arrow = (dir: number, icon: string, word: string) => {
        const b = el("button", "");
        b.type = "button";
        b.dataset.step = String(dir);
        b.innerHTML = icon;
        b.setAttribute("aria-label", `${word}: ${data.entries[items[(i + dir + n) % n]].label}`);
        b.addEventListener("click", () => stepBy(dir));
        return b;
      };
      nav.append(arrow(-1, ICON_PREV, "Previous"), el("span", "", `${i + 1} of ${n}`), arrow(1, ICON_NEXT, "Next"));
      return nav;
    }

    /** The dot before or after the open one, in its part; around at the ends. */
    function stepBy(dir: number): void {
      const e = pinned ? data.entries[pinned] : null;
      if (!e || e.isCore) return;
      const items = data.cores[e.core].items;
      const next = items[(items.indexOf(pinned!) + dir + items.length) % items.length];
      const keep = overlay!.contains(document.activeElement);
      pin(next);
      if (keep) overlay!.querySelector<HTMLButtonElement>(`.qm-nav button[data-step="${dir}"]`)?.focus();
    }

    /** "Copy link": the map's address with this item, to send to someone. */
    function copyLink(key: string): HTMLButtonElement {
      const b = el("button", "qm-copylink");
      b.type = "button";
      b.innerHTML = ICON_LINK;
      const word = el("span", "", "Copy link");
      b.append(word);
      let reset = 0;
      b.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(`${location.origin}${location.pathname}#${key}`);
        } catch {
          return;
        }
        word.textContent = "Copied";
        window.clearTimeout(reset);
        reset = window.setTimeout(() => (word.textContent = "Copy link"), 1500);
      });
      return b;
    }

    function show(key: string): void {
      const out: Node[] = [];
      const goal = data.goals[key];
      if (goal) {
        out.push(el("p", "qm-eyebrow", "I want to"));
        const title = el("p", "qm-title", goal.label);
        title.id = "qm-overlay-title";
        out.push(title);
        const body = root.querySelector<HTMLTemplateElement>(`template[data-qm-goal="${key}"]`);
        if (body) out.push(body.content.cloneNode(true));
      } else {
        const e = data.entries[key];
        const core = data.cores[e.core];
        if (e.isCore) out.push(el("p", "qm-eyebrow", "A part of QueenMQ"));
        else {
          const row = el("div", "qm-head-row");
          row.append(jump(e.core, core.label, "qm-eyebrow"), navOf(key, core.items));
          out.push(row);
        }
        const title = el("p", "qm-title");
        title.id = "qm-overlay-title";
        if (e.isCore) {
          const chip = el("span", "qm-title-box", e.label);
          const icon = root.querySelector<HTMLTemplateElement>(`template[data-qm-icon="${key}"]`);
          if (icon) chip.prepend(icon.content.cloneNode(true));
          title.append(chip);
        }
        else title.append(el("span", "qm-title-dot"), document.createTextNode(e.label));
        if (e.since) title.append(el("span", "qm-since-badge", e.since));
        out.push(title);
        const body = root.querySelector<HTMLTemplateElement>(`template[data-qm-body="${key}"]`);
        if (body) out.push(body.content.cloneNode(true));
        if (e.isCore && core.items.length) {
          out.push(el("p", "qm-k", "Its dots"));
          const chips = el("div", "qm-chips");
          for (const id of core.items) chips.append(jump(id, data.entries[id].label));
          out.push(chips);
        }
      }
      // A click inside it (a step, a chip) replaces what had the focus: the
      // overlay keeps it, so ← → and Escape still reach the map.
      const hadFocus = overlayBody!.contains(document.activeElement);
      overlayBody!.replaceChildren(...out);
      if (hadFocus) overlay!.focus({ preventScroll: true });
      for (const b of overlayBody!.querySelectorAll<HTMLButtonElement>("[data-jump]")) b.addEventListener("click", () => pin(b.dataset.jump!));
      overlayBody!.querySelector(".qm-more")?.append(copyLink(key));
      overlay!.scrollTop = 0;
      // The site's own copy button on the overlay's code, as on every code block
      // of the docs: the site adds it to the code blocks it finds on this event.
      document.dispatchEvent(new Event("nimbus:remount"));
    }

    /**
     * The overlay opens on the half of the screen away from what it is about; a
     * goal's, on the side where it hides fewest of the goal's numbers.
     */
    function side(key: string): "left" | "right" {
      if (key in data.goals) {
        const marks = [...svg!.querySelectorAll(`[data-steps="${key}"] .qm-step-mark`)].map((m) => m.getBoundingClientRect());
        const hidden = (at: "left" | "right") => {
          overlay!.dataset.side = at;
          const o = overlay!.getBoundingClientRect();
          return marks.filter((r) => r.right > o.left && r.left < o.right && r.bottom > o.top && r.top < o.bottom).length;
        };
        return hidden("left") < hidden("right") ? "left" : "right";
      }
      const node = nodes.get(key);
      if (!node) return "right";
      const r = node.getBoundingClientRect();
      return r.left + r.width / 2 > window.innerWidth / 2 ? "left" : "right";
    }

    // From 64rem the overlay is a sidebar, always there: it shows what was
    // clicked, which stays while the pointer looks around; with nothing clicked,
    // what the pointer is on; else the rest view (how to read the map, and the
    // goals). Below, it is the card (on a phone, the sheet) that a click opens,
    // and the pointer gets a tooltip.
    const wide = window.matchMedia("(min-width: 64rem)");
    // The rest view, as the page drew it, to put back.
    const restView = document.createDocumentFragment();
    for (const n of overlayBody.childNodes) restView.append(n.cloneNode(true));
    /** What the sidebar shows now; undefined until it first shows anything. */
    let shown: string | null | undefined;
    function syncSidebar(): void {
      if (!wide.matches) return;
      overlay!.hidden = false;
      overlay!.setAttribute("role", "region");
      const key = pinned ?? hovered;
      if (key === shown) return;
      shown = key;
      if (key) {
        show(key);
        overlay!.dataset.kind = key in data.goals ? "goal" : "entry";
        delete overlay!.dataset.rest;
      } else {
        overlayBody!.replaceChildren(restView.cloneNode(true));
        overlay!.dataset.kind = "rest";
        overlay!.dataset.rest = "";
        overlay!.scrollTop = 0;
      }
    }
    // Across 64rem (a window made narrower or wider), the other way of showing.
    wide.addEventListener("change", () => {
      shown = undefined;
      tip!.classList.remove("qm-tip-on");
      if (wide.matches) syncSidebar();
      else {
        overlay!.setAttribute("role", "dialog");
        delete overlay!.dataset.rest;
        pin(pinned);
      }
    });

    function pin(key: string | null, opts: { focus?: boolean } = {}): void {
      pinned = known(key) ? key : null;
      // A click is a choice: what the pointer was on gives way to it.
      hovered = null;
      tip!.classList.remove("qm-tip-on");
      // A goal and the find field both light pieces: the last one asked wins.
      if (pinned && pinned in data.goals) clearFind();
      paint();
      if (wide.matches) {
        syncSidebar();
        if (opts.focus && pinned) close!.focus();
      } else if (pinned) {
        show(pinned);
        overlay!.dataset.kind = pinned in data.goals ? "goal" : "entry";
        overlay!.hidden = false;
        overlay!.dataset.side = side(pinned);
        if (opts.focus) close!.focus();
      } else {
        overlay!.hidden = true;
      }
      history.replaceState(null, "", pinned ? `#${pinned}` : location.pathname + location.search);
    }

    // The find field: every word typed must be in a dot's or a part's name, its
    // line, a setting's name or what another broker calls it. Under the field,
    // the other brokers' names it matched, so "exchange" says why it lit what it
    // lit. Enter opens the first match; Escape closes the overlay, then clears
    // the words, then leaves the field.
    function onFind(): void {
      const words = findInput!.value.toLowerCase().split(/\s+/).filter(Boolean);
      const has = (text: string) => words.every((w) => text.toLowerCase().includes(w));
      found = words.length ? new Set(Object.keys(data.entries).filter((id) => has(data.entries[id].find))) : null;
      if (found && pinned && pinned in data.goals) pin(null);
      findBox!.classList.toggle("qm-find-on", !!found);
      findN!.textContent = !found ? "" : found.size ? `${found.size} on the map` : "No match";
      // Other brokers' names that matched, by broker: "RabbitMQ: exchange, binding".
      const by = new Map<string, Set<string>>();
      for (const id of found ?? []) {
        for (const [term, where] of data.entries[id].aka) if (has(term)) by.set(where, (by.get(where) ?? new Set()).add(term));
      }
      findWhy!.replaceChildren();
      // The word as typed first, then the shortest: "exchange" before "topic exchange".
      const q = words.join(" ");
      const rank = (t: string) => (t.toLowerCase() === q ? 0 : 1) * 1000 + t.length;
      const brokers = [...by].sort(([, a], [, b]) => Math.min(...[...a].map(rank)) - Math.min(...[...b].map(rank)));
      brokers.slice(0, 3).forEach(([where, terms], i) => {
        if (i) findWhy!.append(" · ");
        const list = [...terms].sort((x, y) => rank(x) - rank(y));
        findWhy!.append(el("b", "", where), `: ${list.slice(0, 3).join(", ")}${list.length > 3 ? ", …" : ""}`);
      });
      if (by.size > 3) findWhy!.append(" · …");
      paint();
    }
    function clearFind(): void {
      if (!findInput!.value && !found) return;
      findInput!.value = "";
      onFind();
    }
    findInput.addEventListener("input", onFind);
    findInput.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape") {
        // The overlay first (Enter may have opened it), then the words, then the field.
        ev.stopPropagation();
        if (pinned) pin(null);
        else if (findInput!.value) clearFind();
        else findInput!.blur();
      } else if (ev.key === "Enter" && found?.size) {
        ev.preventDefault();
        pin([...found][0]);
      }
    });
    // "/" to find, and the arrows to walk a part's dots, while the map has the focus:
    // single keys follow the reader's choice for the site's shortcuts.
    onShortcut(
      "/",
      (ev) => {
        ev.preventDefault();
        findInput!.focus();
        findInput!.select();
      },
      { within: root },
    );
    for (const [key, dir] of [
      ["ArrowLeft", -1],
      ["ArrowRight", 1],
    ] as const) {
      onShortcut(
        key,
        (ev) => {
          const e = pinned && !overlay!.hidden ? data.entries[pinned] : null;
          if (!e || e.isCore) return;
          ev.preventDefault();
          stepBy(dir);
        },
        { within: root },
      );
    }
    syncShortcutHints(root);

    // -----------------------------------------------------------------------
    // Where the tooltip goes. It hides nothing the reader may want next: no
    // icon, no name, no dot and no dot's words (lines it may cover), and not the
    // open overlay. A dot's tooltip sits beside its whole list, at the dot's
    // height, on the side of the words when there is room: the pointer walks
    // down the list and every next dot stays in sight. The place is chosen for
    // the whole list, sized for its longest text, so it does not jump from one
    // dot to the next. Where neither side has room it goes over or under the
    // list; a narrower tooltip only when the widest fits nowhere near. Only the
    // end of a list far from that place (the low steps of the queue's
    // staircase) puts each tooltip beside its own dot instead.
    // -----------------------------------------------------------------------

    type Box = { l: number; t: number; r: number; b: number };
    type Where = "right" | "left" | "below" | "above";
    const GAP = 12; // between the tooltip and what it is about, in px
    const PAD = 6; // kept clear around what it must not cover
    const EDGE = 4; // from the canvas's edges
    const TIP_REM = [17, 15, 13, 11]; // its widths, widest first
    const FAR = 140; // a dot leaves its list's place only when that is farther than this, in px
    const STAY = 60; // and when its own place is nearer by this much

    const union = (a: Box, b: Box): Box => ({ l: Math.min(a.l, b.l), t: Math.min(a.t, b.t), r: Math.max(a.r, b.r), b: Math.max(a.b, b.b) });
    const grow = (a: Box, p: number): Box => ({ l: a.l - p, t: a.t - p, r: a.r + p, b: a.b + p });
    /** How far the eye goes between two boxes; 0 when they touch. Along a row is easy, so up or down counts twice. */
    const apart = (a: Box, b: Box) => Math.hypot(Math.max(0, a.l - b.r, b.l - a.r), 2 * Math.max(0, a.t - b.b, b.t - a.b));
    const mid = (b: Box) => (b.t + b.b) / 2;

    /** A box on the screen in the canvas's coordinates: those of the tooltip's left and top. */
    function local(r: DOMRect, origin: DOMRect): Box {
      const dx = canvas!.scrollLeft - origin.left;
      return { l: r.left + dx, t: r.top - origin.top, r: r.right + dx, b: r.bottom - origin.top };
    }

    /** What a node shows: a dot and its words, or an icon and its name; not its line or its hit area. */
    function ink(node: SVGGElement, origin: DOMRect): Box {
      let box: Box | null = null;
      for (const part of node.querySelectorAll(".qm-dotc, .qm-label, .qm-icon, .qm-node-label")) {
        const b = local(part.getBoundingClientRect(), origin);
        box = box ? union(box, b) : b;
      }
      return box ?? local(node.getBoundingClientRect(), origin);
    }

    /** The top of the free band nearest to `want` for a box w by h at x, between top and bottom; null if none. */
    function freeTop(x: number, w: number, h: number, want: number, blocks: Box[], top: number, bottom: number): number | null {
      const bands: [number, number][] = [];
      let from = top;
      for (const b of blocks.filter((k) => k.r > x && k.l < x + w).sort((p, q) => p.t - q.t)) {
        if (b.t >= bottom) break;
        bands.push([from, b.t]);
        from = Math.max(from, b.b);
      }
      bands.push([from, bottom]);
      let best: number | null = null;
      for (const [lo, hi] of bands) {
        if (hi - lo < h) continue;
        const y = Math.min(Math.max(want, lo), hi - h);
        if (best === null || Math.abs(y - want) < Math.abs(best - want)) best = y;
      }
      return best;
    }

    function fillTip(key: string): void {
      const e = data.entries[key];
      tip!.replaceChildren(el("strong", "", e.label), document.createTextNode(e.line));
    }

    /** The tooltip's height for an entry at a width, measured once (again once the fonts arrive). */
    const heights = new Map<string, number>();
    document.fonts?.addEventListener("loadingdone", () => heights.clear());
    function tipHeight(key: string, w: number): number {
      const k = `${key} ${w}`;
      let h = heights.get(k);
      if (h === undefined) {
        fillTip(key);
        tip!.style.width = `${w}px`;
        h = tip!.offsetHeight;
        heights.set(k, h);
      }
      return h;
    }

    function placeTip(node: SVGGElement): void {
      const key = node.dataset.id!;
      const e = data.entries[key];
      if (!e) return;
      const origin = canvas!.getBoundingClientRect();
      const inks = new Map<string, Box>();
      for (const [id, n] of nodes) inks.set(id, ink(n, origin));
      const item = inks.get(key)!;
      // A dot is placed with its list; a part on its own.
      const rows = (e.isCore ? [key] : data.cores[e.core].items).map((id) => ({ id, box: inks.get(id)! }));
      const list = rows.map((r) => r.box).reduce(union);
      const blocks = [...inks.values()].map((b) => grow(b, PAD));
      if (!overlay!.hidden) blocks.push(grow(local(overlay!.getBoundingClientRect(), origin), PAD));
      for (const extra of svg!.querySelectorAll(".qm-steps.qm-on .qm-step-mark")) {
        const r = extra.getBoundingClientRect();
        if (r.width) blocks.push(grow(local(r, origin), PAD));
      }
      const view: Box = {
        l: canvas!.scrollLeft + EDGE,
        r: canvas!.scrollLeft + canvas!.clientWidth - EDGE,
        t: Math.max(0, -origin.top) + EDGE,
        b: Math.min(canvas!.clientHeight, window.innerHeight - origin.top) - EDGE,
      };
      // The side of a dot's words; a part has none.
      const words: Where | null = e.isCore
        ? null
        : node.querySelector(".qm-label")?.getAttribute("text-anchor") === "end"
          ? "left"
          : "right";
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;

      // The list's place, the same for every dot of it: every place tried is
      // scored by how far the eye goes from each dot to its tooltip, on average,
      // and must be free for every dot.
      type Spot = { where: Where; x: number; y: number; w: number; h: number; cost: number };
      const side = (where: Where) => where === "left" || where === "right";
      // A dot's tooltip level with its list on the side of its words is best; one
      // that is not level with it (over, under, or off to a side) costs a little;
      // one level with it on the other side lies over its lines and costs more. A
      // part's sides come before over and under it. A narrower tooltip costs a little.
      const extra = (where: Where, i: number, level: boolean) =>
        (!words ? (side(where) ? 0 : 10) : !level || !side(where) ? 10 : where === words ? 0 : 40) + i * 4;
      const levelWith = (y: number, h: number, b: Box) => y < b.b && y + h > b.t;
      const j = rows.findIndex((r) => r.id === key);
      let home: (Spot & { near: number[]; far: number[] }) | null = null;
      for (const [i, size] of TIP_REM.entries()) {
        const w = Math.round(size * rem);
        const h = Math.max(...rows.map((r) => tipHeight(r.id, w)));
        // Beside the list: next to it, at the canvas's edge, or just past anything
        // in the way. Over or under it: lined up with it or with an edge.
        const near = blocks.filter((b) => b.b > list.t - h && b.t < list.b + h);
        const xs: Record<Where, number[]> = {
          right: [list.r + GAP, view.r - w, ...near.map((b) => b.r)].filter((x) => x >= list.r + GAP && x <= view.r - w),
          left: [list.l - GAP - w, view.l, ...near.map((b) => b.l - w)].filter((x) => x >= view.l && x <= list.l - GAP - w),
          below: [],
          above: [],
        };
        for (const x of [list.l, list.r - w, view.l, view.r - w]) {
          const at = Math.min(Math.max(x, view.l), view.r - w);
          xs.below.push(at);
          xs.above.push(at);
        }
        for (const where of ["right", "left", "below", "above"] as Where[]) {
          for (const x of new Set(xs[where])) {
            const ys: number[] = [];
            if (side(where)) {
              for (const r of rows) {
                const y = freeTop(x, w, h, mid(r.box) - h / 2, blocks, view.t, view.b);
                if (y === null) break;
                ys.push(y);
              }
            } else {
              const y =
                where === "below"
                  ? freeTop(x, w, h, list.b + GAP, blocks, list.b + GAP, view.b)
                  : freeTop(x, w, h, list.t - GAP - h, blocks, view.t, list.t - GAP);
              if (y !== null) ys.push(...rows.map(() => y));
            }
            if (ys.length < rows.length) continue;
            const far = rows.map((r, k) => apart({ l: x, t: ys[k], r: x + w, b: ys[k] + h }, r.box));
            // A place that leaps (over a part's icon, say) between two neighbour
            // dots costs that leap: walking down a list, the tooltip should glide.
            let leaps = 0;
            for (let k = 1; k < rows.length; k++) {
              leaps += Math.max(0, Math.abs(ys[k] - ys[k - 1]) - Math.abs(mid(rows[k].box) - mid(rows[k - 1].box)));
            }
            const more = extra(where, i, ys.some((y) => levelWith(y, h, list)));
            const cost = (far.reduce((s, d) => s + d, 0) + leaps) / rows.length + more;
            if (!home || cost < home.cost) home = { where, x, y: ys[j], w, h, cost, near: far, far: far.map((d) => d + more) };
          }
        }
      }

      // A place beside a dot itself: on the queue's staircase each step down is
      // further right, so a low step has room just past its own dot.
      function beside(r: { id: string; box: Box }): Spot | null {
        let spot: Spot | null = null;
        for (const [i, size] of TIP_REM.entries()) {
          const w = Math.round(size * rem);
          const h = tipHeight(r.id, w);
          for (const [where, x] of [
            ["right", r.box.r + GAP],
            ["left", r.box.l - GAP - w],
          ] as [Where, number][]) {
            if (x < view.l || x + w > view.r) continue;
            const y = freeTop(x, w, h, mid(r.box) - h / 2, blocks, view.t, view.b);
            if (y === null) continue;
            const cost = apart({ l: x, t: y, r: x + w, b: y + h }, r.box) + extra(where, i, levelWith(y, h, r.box));
            if (!spot || cost < spot.cost) spot = { where, x, y, w, h, cost };
          }
        }
        return spot;
      }
      // A dot leaves its list's place for its own only when the list's is far from
      // it and its own much nearer, and only with every dot after it in the list:
      // the tail of the staircase changes sides once, not back and forth.
      const leaves = (k: number) => {
        if (!home || home.near[k] < FAR) return null;
        const spot = beside(rows[k]);
        return spot && spot.cost + STAY < home.far[k] ? spot : null;
      };
      let own = e.isCore ? null : leaves(j);
      for (let k = j + 1; own && k < rows.length; k++) if (!leaves(k)) own = null;

      fillTip(key);
      tip!.classList.add("qm-tip-on");
      const best = own ?? home;
      if (!best) {
        // Nowhere free (a very small window): next to the item, as before.
        const w = Math.round(TIP_REM[0] * rem);
        const h = tipHeight(key, w);
        fillTip(key);
        tip!.style.width = `${w}px`;
        tip!.style.left = `${Math.min(Math.max(item.r + GAP, view.l), view.r - w)}px`;
        tip!.style.top = `${Math.min(Math.max(mid(item) - h / 2, view.t), view.b - h)}px`;
        return;
      }
      const h = tipHeight(key, best.w);
      fillTip(key);
      tip!.style.width = `${best.w}px`;
      let y = best.y;
      if (best === home && side(best.where)) {
        // Beside the list: at the dot's own height, as near as the free bands allow.
        y = freeTop(best.x, best.w, h, mid(item) - h / 2, blocks, view.t, view.b) ?? y;
      } else if (best.where === "above") {
        // Placed for the list's longest text: a shorter one keeps to the list.
        y += best.h - h;
      }
      tip!.style.left = `${best.x}px`;
      tip!.style.top = `${y}px`;
    }

    let leaving = 0;
    function hover(node: SVGGElement | null): void {
      window.clearTimeout(leaving);
      hovered = node ? node.dataset.id! : null;
      if (wide.matches) syncSidebar();
      // The open item needs no tooltip: the overlay already says it.
      else if (node && hovered !== pinned) placeTip(node);
      else tip!.classList.remove("qm-tip-on");
      paint();
    }

    // Leaving a dot for the empty map waits a moment: a pointer on its way to
    // the next dot does not switch everything off and on again. With the
    // sidebar a little longer, and a pointer that reaches the sidebar keeps
    // what it shows, to read it or follow its links.
    function leave(): void {
      window.clearTimeout(leaving);
      leaving = window.setTimeout(() => hover(null), wide.matches ? 180 : 110);
    }
    overlay.addEventListener("pointerenter", () => {
      if (wide.matches) window.clearTimeout(leaving);
    });
    overlay.addEventListener("pointerleave", () => {
      if (wide.matches && hovered) leave();
    });
    // The sidebar's width: drag its edge, or ← → on the edge; a double-click
    // puts it back. Between 18rem and 40rem, and never over the find field; this
    // browser remembers it (a convenience: nothing else depends on it).
    const handle = root.querySelector<HTMLElement>("[data-qm-resize]");
    const WIDTH_KEY = "qm-panel-width";
    const page = document.documentElement;
    const limits = () => {
      const rem = parseFloat(getComputedStyle(page).fontSize) || 16;
      const max = Math.min(40 * rem, window.innerWidth / 2 - 10.5 * rem);
      return { min: 18 * rem, max: Math.max(18 * rem, max) };
    };
    function setWidth(px: number | null, save = false): void {
      if (px === null) page.style.removeProperty("--nb-panel-width");
      else {
        const { min, max } = limits();
        page.style.setProperty("--nb-panel-width", `${Math.round(Math.min(Math.max(px, min), max))}px`);
      }
      const now = Math.round(overlay!.getBoundingClientRect().width);
      const { min, max } = limits();
      handle?.setAttribute("aria-valuenow", String(now));
      handle?.setAttribute("aria-valuemin", String(Math.round(min)));
      handle?.setAttribute("aria-valuemax", String(Math.round(max)));
      if (!save) return;
      try {
        if (px === null) localStorage.removeItem(WIDTH_KEY);
        else localStorage.setItem(WIDTH_KEY, String(now));
      } catch {}
    }
    // The width this browser kept, once the sidebar is on screen.
    function applySaved(): void {
      if (!wide.matches) return;
      try {
        const saved = Number(localStorage.getItem(WIDTH_KEY));
        if (saved > 0) setWidth(saved);
      } catch {}
    }
    applySaved();
    wide.addEventListener("change", applySaved);
    if (handle) {
      handle.addEventListener("pointerdown", (ev) => {
        if (ev.button !== 0) return;
        ev.preventDefault();
        handle.setPointerCapture(ev.pointerId);
        handle.classList.add("qm-resizing");
        page.classList.add("qm-resizing-page");
      });
      handle.addEventListener("pointermove", (ev) => {
        if (handle.hasPointerCapture(ev.pointerId)) setWidth(window.innerWidth - ev.clientX);
      });
      const done = (ev: PointerEvent) => {
        if (!handle.hasPointerCapture(ev.pointerId)) return;
        handle.releasePointerCapture(ev.pointerId);
        handle.classList.remove("qm-resizing");
        page.classList.remove("qm-resizing-page");
        setWidth(overlay!.getBoundingClientRect().width, true);
      };
      handle.addEventListener("pointerup", done);
      handle.addEventListener("pointercancel", done);
      handle.addEventListener("dblclick", () => setWidth(null, true));
      handle.addEventListener("keydown", (ev) => {
        if (ev.key !== "ArrowLeft" && ev.key !== "ArrowRight") return;
        // The edge's own keys: the arrows that walk a part's dots stay out of it.
        ev.preventDefault();
        ev.stopPropagation();
        setWidth(overlay!.getBoundingClientRect().width + (ev.key === "ArrowLeft" ? 16 : -16), true);
      });
      // A window made narrower keeps the field clear.
      window.addEventListener("resize", () => {
        if (wide.matches && page.style.getPropertyValue("--nb-panel-width")) setWidth(overlay!.getBoundingClientRect().width);
      });
    }

    // The rest view's goals.
    overlayBody.addEventListener("click", (ev) => {
      const b = ev.target instanceof Element ? ev.target.closest<HTMLElement>("[data-pick-goal]") : null;
      if (b) pin(b.dataset.pickGoal!);
    });

    const nodeOf = (t: EventTarget | null) => (t instanceof Element ? t.closest<SVGGElement>("[data-id]") : null);

    svg.addEventListener("pointerover", (ev) => {
      if (ev.pointerType !== "mouse") return;
      const n = nodeOf(ev.target);
      if (n && n.dataset.id !== hovered) hover(n);
    });
    svg.addEventListener("pointerout", (ev) => {
      if (ev.pointerType !== "mouse") return;
      const from = nodeOf(ev.target);
      const to = nodeOf(ev.relatedTarget);
      if (from && from !== to) {
        if (to) hover(to);
        else leave();
      }
    });
    svg.addEventListener("pointerleave", () => leave());
    svg.addEventListener("click", (ev) => {
      const n = nodeOf(ev.target);
      pin(n ? n.dataset.id! : null);
    });
    svg.addEventListener("focusin", (ev) => {
      const n = nodeOf(ev.target);
      if (n && n.matches(":focus-visible")) hover(n);
    });
    svg.addEventListener("focusout", () => {
      if (hovered) hover(null);
    });
    svg.addEventListener("keydown", (ev) => {
      const n = nodeOf(ev.target);
      if (n && (ev.key === "Enter" || ev.key === " ")) {
        ev.preventDefault();
        pin(n.dataset.id!, { focus: true });
      }
    });
    root.addEventListener("keydown", (ev) => {
      if (ev.key !== "Escape") return;
      const focused = document.activeElement;
      if (focused instanceof SVGElement && svg.contains(focused)) focused.blur();
      hover(null);
      if (pinned) pin(null);
      else clearFind();
    });
    for (const b of goalButtons) {
      b.addEventListener("click", () => pin(pinned === b.dataset.goal ? null : b.dataset.goal!));
    }
    close.addEventListener("click", () => pin(null));

    // A link to /map/#lease, from another page.
    function fromHash(): void {
      const key = decodeURIComponent(location.hash.slice(1));
      if (!known(key)) return;
      pin(key);
      stage!.scrollIntoView({ block: "start" });
    }
    window.addEventListener("hashchange", fromHash);
    syncSidebar();
    fromHash();
  }
</script>
