---
/**
 * The map of QueenMQ (/map/): every core as a yellow icon, every option or
 * feature of a core as a quiet grey dot that turns yellow when you point at it,
 * an overlay for the one you click, a field to find an option by a word you
 * know, and under the map the goals ("I want to...") that number a pattern's
 * pieces in the order you use them. The words are src/lib/map.ts (also the
 * page's markdown twin, with every detail); the drawing's numbers are
 * src/lib/map-geometry.ts (also the page's preview image, src/pages/og/map.png.ts);
 * the code is the programs that run (src/lib/book-code.ts) or a docs page's own
 * example.
 *
 * The layout is Alice's sketch (2026-11-16), on a 1210-unit grid:
 *
 *   Push -> Queue -> a bus to the three ways a queue is read: Connectors (top),
 *   Pop (middle, on the line), Stream (bottom). The connectors' line goes back
 *   into Push: a source pushes into queues like any producer.
 *   Under them, one transaction: it acks the queue, pushes the next messages
 *   back into Push, writes KV and locks, and schedules timers.
 *   Ephemeral queues stand apart, their icon dashed: they are outside the log.
 *
 * Each box's dots sit on the side with room, and each dot's curve runs into one
 * point on the box, as in the sketch. Hover a dot or a box to light it and read
 * one line; click it to read it in full in an overlay (and in the URL, /map/#lease).
 */
import { Code } from "./ui/code";
import { MAP_TITLE, cores, goals, intro, entryById, type CoreId, type MapEntry } from "@/lib/map";
import { FRAME, ICON, NAME_Y, R, boxes, flows, txFlows, NOTE, iconSvg, stepMark } from "@/lib/map-geometry";
import { sdkCode } from "@/lib/book-code";

const byId = entryById();

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
/** Text with `inline code` in backticks, as HTML. */
const inline = (s: string) => esc(s).replace(/`([^`]+)`/g, "<code>$1</code>");
/** The same text without the backticks, for a tooltip. */
const plain = (s: string) => s.replace(/`([^`]+)`/g, "$1");

function codeOf(e: MapEntry): { lang: string; code: string } | null {
  if (e.snippet) return e.snippet;
  if (e.code) {
    const js = sdkCode(e.code, "/map/").find((v) => v.lang.id === "js");
    if (js?.code) return { lang: "js", code: js.code };
  }
  return null;
}


/** The overlay's bodies, in the order of the drawing. */
const LIST_ORDER: CoreId[] = ["push", "queue", "connectors", "pop", "stream", "transaction", "kv", "timers", "ephemeral"];
const listed = LIST_ORDER.map((id) => cores.find((c) => c.id === id)!);

/** An entry's other names, as [term, broker] pairs. */
const akaOf = (e: MapEntry) => Object.entries(e.aka ?? {}).flatMap(([where, terms]) => terms.map((t) => [t, where]));
/** What the find field reads of an entry: its name, its line, its settings' names and its other names. */
const findText = (e: MapEntry) =>
  [e.label, plain(e.line), ...(e.settings ?? []).map((s) => s.name), ...akaOf(e).map(([t]) => t)].join(" ").toLowerCase();

/** What the script needs, as data. */
const data = {
  entries: Object.fromEntries(
    [...byId].map(([id, { entry, core }]) => [
      id,
      {
        core: core.id,
        label: entry.label,
        line: plain(entry.line),
        isCore: id === core.id,
        since: entry.since ?? null,
        find: findText(entry),
        aka: akaOf(entry),
      },
    ]),
  ),
  cores: Object.fromEntries(cores.map((c) => [c.id, { label: c.label, items: c.items.map((i) => i.id) }])),
  goals: Object.fromEntries(goals.map((g) => [g.id, { label: g.label, lights: g.steps.map((st) => st.id), href: g.href }])),
};
---

<section class="qm" data-qm data-qm-data={JSON.stringify(data)} data-pagefind-body data-nb-shortcut-scope aria-labelledby="qm-title">
  <div class="qm-stage" data-qm-stage>
    {/* The page is `mode: custom`: no title block above the map. Its title shows
        in the top bar, beside the logo (Header.astro); the h1 here is for screen
        readers and search engines. The field to find an option by a word you
        know (its name, a word of its line, a setting's name, or what another
        broker calls it) sits in the middle of the top bar on a wide screen, and
        above the map on a narrow one. */}
    <h1 class="sr-only" id="qm-title">{MAP_TITLE}</h1>
    <div class="qm-top">
      <div class="qm-find" data-qm-find>
        <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.75"></circle><path d="M10.5 10.5L14 14"></path></svg>
        <input
          type="search"
          data-qm-find-input
          placeholder="Find: retries, exchange, offset…"
          aria-label="Find an option or a setting on the map, by its name or another broker's name for it"
          autocomplete="off"
          spellcheck="false"
          data-nb-shortcut-for="/"
        />
        <span class="qm-find-n" data-qm-find-n aria-live="polite"></span>
        <kbd class="qm-find-key qm-find-slash" data-nb-shortcut-hint="/">/</kbd>
        <kbd class="qm-find-key qm-find-esc">Esc</kbd>
      </div>
      <p class="qm-find-why" data-qm-find-why></p>
    </div>
    <div class="qm-canvas" data-qm-canvas>
      <svg
        class="qm-svg"
        data-qm-svg
        viewBox={`${FRAME.x} ${FRAME.y} ${FRAME.w} ${FRAME.h}`}
        role="group"
        aria-label="The map of QueenMQ: its parts as boxes, their options as dots"
        xmlns="http://www.w3.org/2000/svg"
      >
        <g class="qm-flows" aria-hidden="true">
          {
            flows.map((f) => (
              <g>
                <path class="qm-wire" d={f.d} />
                <path class="qm-head" d={f.head} />
              </g>
            ))
          }
          <text class="qm-note" x={NOTE.sources.x} y={NOTE.sources.y} text-anchor="middle">sources push in</text>
        </g>

        <g class="qm-txflows" aria-hidden="true">
          {
            txFlows.map((f) => (
              <g>
                <path class="qm-wire" d={f.d} />
                <path class="qm-head" d={f.head} />
              </g>
            ))
          }
          <text class="qm-note" x={NOTE.ack.x} y={NOTE.ack.y}>ack</text>
          <text class="qm-note" x={NOTE.next.x} y={NOTE.next.y} text-anchor="middle">next pushes</text>
        </g>

        {
          boxes.map((bx) => (
            <g>
              <g
                class:list={["qm-node", "qm-core", bx.core.id === "ephemeral" && "qm-ghost"]}
                data-id={bx.core.id}
                tabindex="0"
                role="button"
                aria-label={bx.core.label}
              >
                <rect class="qm-hit" x={bx.hit.x} y={bx.hit.y} width={bx.hit.w} height={bx.hit.h} />
                <path class="qm-fanhead" d={bx.fanHead} />
                <circle class="qm-ring" cx={bx.cx} cy={bx.cy} r={ICON / 2 + 13} />
                <g
                  class="qm-icon"
                  transform={`translate(${bx.cx - ICON / 2} ${bx.cy - ICON / 2}) scale(${ICON / 48})`}
                  set:html={iconSvg(bx.core.id)}
                />
                <text class="qm-node-label" x={bx.cx} y={bx.cy + NAME_Y} text-anchor="middle" dominant-baseline="central">
                  {bx.core.label}
                </text>
              </g>
              {bx.dots.map((d) => (
                <g class="qm-node qm-dot" data-id={d.entry.id} tabindex="0" role="button" aria-label={`${d.entry.label}, ${bx.core.label}`}>
                  <rect class="qm-hit" x={d.hit.x} y={d.hit.y} width={d.hit.w} height={d.hit.h} />
                  <path class="qm-wire qm-curve" d={d.curve} />
                  <circle class="qm-ring" cx={d.x} cy={d.y} r={R + 5} />
                  <circle class="qm-dotc" cx={d.x} cy={d.y} r={R} />
                  <text class="qm-label" x={d.lx} y={d.y} text-anchor={d.anchor} dominant-baseline="central">
                    {d.entry.label}
                    {d.entry.since && <tspan class="qm-since" dx="6">{d.entry.since}</tspan>}
                  </text>
                </g>
              ))}
            </g>
          ))
        }

        {/* A goal numbers its pieces in the order you use them; only the picked goal's numbers show. */}
        {
          goals.map((g) => (
            <g class="qm-steps" data-steps={g.id} aria-hidden="true">
              {g.steps.map((st, i) => {
                const m = stepMark(st.id, st.onAckLine);
                return (
                  <g class="qm-step-mark">
                    <circle cx={m.x} cy={m.y} r="10.5" />
                    <text x={m.x} y={m.y + 0.5} text-anchor="middle" dominant-baseline="central">
                      {i + 1}
                    </text>
                  </g>
                );
              })}
            </g>
          ))
        }
      </svg>
      <div class="qm-tip" data-qm-tip aria-hidden="true"></div>
    </div>

    <div class="qm-goals" role="group" aria-label={intro.goalsLabel}>
      <span class="qm-goals-label">{intro.goalsLabel}</span>
      {
        goals.map((g) => (
          <button type="button" class="qm-goal" data-goal={g.id} aria-pressed="false">
            {g.label}
          </button>
        ))
      }
    </div>
  </div>

  {/* The sidebar's edge: drag it, or ← → when it has the focus, to give the map
      or the sidebar more room; a double-click puts it back. */}
  <div
    class="qm-resize"
    data-qm-resize
    role="separator"
    aria-orientation="vertical"
    aria-label="Sidebar width"
    tabindex="0"
  ></div>

  {/* What a click opens: the sidebar from 64rem, there from the first paint with
      its rest view (how to read the map, then the goals); below, a card, or a
      sheet on a phone. */}
  <div class="qm-overlay" data-qm-overlay role="dialog" aria-labelledby="qm-overlay-title" tabindex="-1" data-rest hidden>
    <button type="button" class="qm-close" data-qm-close aria-label="Close">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"></path></svg>
    </button>
    <div data-qm-overlay-body>
      <p class="qm-eyebrow" id="qm-overlay-title">How to read it</p>
      <p class="qm-text qm-rest-text">
        Point at a part or a dot: what it does, its settings and defaults, when to use it, other brokers' names for it and its code show
        here. Click it to keep it here while you look around.
      </p>
      <p class="qm-k">{intro.goalsLabel}</p>
      <ul class="qm-rest-goals">
        {
          goals.map((g) => (
            <li>
              <button type="button" class="qm-rest-goal" data-pick-goal={g.id}>
                {g.label}
                <span aria-hidden="true">→</span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {
    cores.map((core) => (
      <template data-qm-icon={core.id}>
        <svg class="qm-title-icon" viewBox="0 0 48 48" aria-hidden="true" set:html={iconSvg(core.id)} />
      </template>
    ))
  }

  {
    listed.flatMap((core) =>
      [core, ...core.items].map((e) => {
        const code = codeOf(e);
        return (
          <template data-qm-body={e.id}>
            <p class="qm-text" set:html={inline(e.line)} />
            {e.settings && (
              <table class="qm-settings">
                <thead>
                  <tr>
                    <th>{e.settingsName ?? "Setting"}</th>
                    <th>{e.settingsHead ?? "Default"}</th>
                  </tr>
                </thead>
                <tbody>
                  {e.settings.map((s) => (
                    <tr>
                      <td>
                        <code class="qm-mono">{s.name}</code>
                      </td>
                      <td>{s.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            <p class="qm-k">When to use it</p>
            <p class="qm-text qm-use" set:html={inline(e.use)} />
            {e.aka && (
              <>
                <p class="qm-k">Other names</p>
                <ul class="qm-aka">
                  {Object.entries(e.aka).map(([where, terms]) => (
                    <li>
                      <span class="qm-aka-where">{where}</span> {terms.join(", ")}
                    </li>
                  ))}
                </ul>
              </>
            )}
            {code && (
              <div class="qm-code">
                <Code code={code.code} lang={code.lang as any} />
              </div>
            )}
            <p class="qm-more">
              <a class="qm-link" href={e.docs}>
                Read it in the docs →
              </a>
            </p>
          </template>
        );
      }),
    )
  }


  {
    goals.map((g) => (
      <template data-qm-goal={g.id}>
        <p class="qm-text" set:html={inline(g.intro)} />
        <ol class="qm-steps-list">
          {g.steps.map((st, i) => (
            <li>
              <button type="button" class="qm-step" data-jump={st.id}>
                <span class="qm-step-n">{i + 1}</span>
                <span class="qm-step-body">
                  <span class="qm-step-name">{byId.get(st.id)!.entry.label}</span>
                  <span class="qm-step-text" set:html={inline(st.text)} />
                </span>
              </button>
            </li>
          ))}
        </ol>
        <p class="qm-more">
          <a class="qm-link" href={g.href}>
            See it worked out →
          </a>
        </p>
      </template>
    ))
  }
</section>

<style is:global>
  /* Scoped by the .qm prefix, not by Astro: the overlay and the tooltip are filled by
     the script, with elements that carry no scope attribute. */
  .qm {
    /* The site's yellow. On the light page, thin yellow lines fade into the paper:
       there the map's yellow is the same hue, a step deeper. */
    --qm-yellow: color-mix(in srgb, var(--nb-brand) 74%, #1b1a18);
    --qm-ink: #1b1a18;
    /* An option at rest: a small warm grey dot, its words a step under a part's
       name. Yellow is for the nine parts and for what you point at. */
    --qm-dot: #b3ada5;
    --qm-soft: #5f5a54;
    --qm-fg: var(--nb-foreground);
    --qm-muted: var(--nb-muted-foreground);
    --qm-w: calc(100vw - 3rem);
    width: var(--qm-w);
    margin-left: calc((100% - var(--qm-w)) / 2);
    padding: 0.5rem 0 0.75rem;
  }

  [data-mode="dark"] .qm {
    --qm-yellow: var(--nb-brand);
    --qm-dot: #6f6a63;
    --qm-soft: #aaa49c;
  }
  .qm-goals {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }
  .qm-goals-label,
  .qm-eyebrow,
  .qm-k,
  .qm-settings th {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--qm-muted);
  }
  .qm-goals-label {
    margin-right: 0.375rem;
  }
  .qm-goal {
    border: 1px solid var(--nb-line);
    border-radius: var(--nb-r-ctl);
    background: transparent;
    color: var(--qm-fg);
    padding: calc(0.3125rem - 1px) calc(0.75rem - 1px);
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    cursor: pointer;
  }
  .qm-goal:hover {
    border-color: var(--qm-muted);
  }
  .qm-goal[aria-pressed="true"] {
    border-color: var(--qm-yellow);
    box-shadow: inset 0 0 0 1px var(--qm-yellow);
  }
  [data-mode="dark"] .qm-goal[aria-pressed="true"] {
    box-shadow: none;
    color: var(--qm-yellow);
  }
  .qm-goal:focus-visible {
    outline: 2px solid var(--nb-ring);
    outline-offset: 2px;
  }
  @media (max-width: 47.99rem) {
    .qm-goals {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 0.25rem;
    }
    .qm-goals::-webkit-scrollbar {
      display: none;
    }
    .qm-goal,
    .qm-goals-label {
      flex: none;
    }
  }

  .qm-stage {
    position: relative;
    scroll-margin-top: 4.5rem;
  }
  /* From 64rem, everything on one screen: the stage fills the window under the
     header, the goals take the rows they need, and the drawing scales into the
     rest (the viewBox keeps its proportions and centres it). */
  @media (min-width: 64rem) {
    .qm-stage {
      display: flex;
      flex-direction: column;
      height: calc(100vh - 4.75rem);
      height: calc(100dvh - 4.75rem);
    }
    .qm-canvas {
      flex: 1 1 0;
      min-height: 0;
    }
    /* .qm-stage in front: the base .qm-svg rule further down sets height: auto. */
    .qm-stage .qm-svg {
      height: 100%;
    }
    .qm-goals {
      flex: none;
    }
  }
  .qm-canvas {
    position: relative;
    overflow-x: auto;
  }
  .qm-svg {
    display: block;
    width: 100%;
    min-width: 60rem;
    height: auto;
    /* A click on the empty map gives the svg the focus; Chrome then draws its
       focus ring (the system accent colour) around the whole drawing. The svg
       is not in the tab order: keyboard focus lands on the boxes and dots,
       which draw their own ring. */
    outline: none;
    font-family: var(--nb-font-sans);
    -webkit-tap-highlight-color: transparent;
  }

  /* The drawing, in the sketch's language. The message's path (push, the queue,
     its readers, the ack, the next pushes) is the strongest line on the map; an
     option's line into its part is a hairline until it or its part is lit. */
  .qm-wire {
    fill: none;
    stroke: var(--qm-fg);
    stroke-opacity: 0.9;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .qm-curve {
    stroke-opacity: 0.24;
    stroke-width: 0.9;
  }
  .qm-head {
    fill: var(--qm-fg);
    fill-opacity: 0.9;
    stroke: var(--qm-fg);
    stroke-opacity: 0.9;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .qm-fanhead {
    fill: var(--qm-fg);
    fill-opacity: 0.35;
  }
  .qm-note {
    fill: var(--qm-fg);
    fill-opacity: 0.72;
    font-size: 12.5px;
  }
  .qm-icon {
    color: var(--qm-yellow);
  }
  .qm-node-label {
    fill: var(--qm-fg);
    font-size: 16px;
    font-weight: 600;
  }
  .qm-dotc {
    fill: var(--qm-dot);
  }
  .qm-label {
    fill: var(--qm-soft);
    font-size: 15px;
  }
  .qm-since {
    fill: var(--qm-muted);
    font-size: 12px;
    font-weight: 600;
  }
  .qm-hit {
    fill: transparent;
  }
  .qm-ring {
    fill: none;
    stroke: var(--qm-fg);
    stroke-width: 1.5;
    opacity: 0;
  }

  .qm-node {
    cursor: pointer;
    outline: none;
  }
  /* What the pointer is on, or what was clicked, is highlighted: a ring, its
     name in bold, its line drawn bright. Nothing else on the map changes. */
  .qm-node.qm-picked .qm-ring,
  .qm-node.qm-hover .qm-ring,
  .qm-core.qm-found .qm-ring,
  .qm-node:focus-visible .qm-ring {
    opacity: 1;
  }
  .qm-dot.qm-picked .qm-label,
  .qm-dot.qm-hover .qm-label {
    font-weight: 600;
  }
  .qm-dot.qm-picked .qm-dotc,
  .qm-dot.qm-hover .qm-dotc,
  .qm-dot.qm-fan-lit .qm-dotc,
  .qm-dot.qm-on .qm-dotc,
  .qm-dot:focus-visible .qm-dotc {
    fill: var(--qm-yellow);
  }
  .qm-dot.qm-picked .qm-label,
  .qm-dot.qm-hover .qm-label,
  .qm-dot.qm-fan-lit .qm-label,
  .qm-dot.qm-on .qm-label,
  .qm-dot:focus-visible .qm-label {
    fill: var(--qm-fg);
  }
  .qm-dot.qm-picked .qm-curve,
  .qm-dot.qm-hover .qm-curve,
  .qm-dot.qm-fan-lit .qm-curve {
    stroke-opacity: 1;
    stroke-width: 1.8;
  }
  .qm-core.qm-picked .qm-fanhead,
  .qm-core.qm-hover .qm-fanhead {
    fill-opacity: 1;
  }
  /* A goal ("I want to") lights its pieces and steps the other dots back; the
     icons never do. The dot under the pointer stays bright. */
  .qm-svg.qm-focus .qm-dot:not(.qm-on):not(.qm-hover) {
    opacity: 0.25;
  }
  .qm-svg.qm-focus .qm-flows,
  .qm-svg.qm-focus .qm-txflows {
    opacity: 0.35;
  }
  .qm-svg.qm-focus .qm-core:not(.qm-on) .qm-fanhead {
    opacity: 0.4;
  }
  .qm-dot.qm-on .qm-curve {
    stroke-opacity: 1;
    stroke-width: 1.8;
  }
  .qm-svg.qm-tx-on .qm-txflows {
    opacity: 1;
  }
  .qm-svg.qm-tx-on .qm-txflows .qm-wire {
    stroke-opacity: 1;
    stroke-width: 2.6;
  }
  .qm-svg.qm-tx-on .qm-txflows .qm-head {
    fill-opacity: 1;
  }

  /* A goal's numbers on the map: only the picked goal's show. */
  .qm-steps {
    display: none;
  }
  .qm-steps.qm-on {
    display: inline;
  }
  .qm-step-mark circle {
    fill: var(--qm-yellow);
  }
  .qm-step-mark text {
    fill: var(--qm-ink);
    font-size: 12.5px;
    font-weight: 700;
  }

  /* The find field: in the middle of the top bar on a wide screen (the bar is
     3.5rem tall and sticky, so the field stays in it), above the map on a
     narrow one. The page's title in the bar (Header.astro) stops short of it. */
  .qm-top {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: min(19rem, 100%);
    margin-bottom: 0.75rem;
  }
  @media (min-width: 64rem) {
    .qm-top {
      position: fixed;
      z-index: 31;
      top: 0.625rem;
      left: 50%;
