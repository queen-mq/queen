---
import { Icon } from "astro-icon/components";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import { SearchTrigger } from "./ui/search";
import { config } from "virtual:nimbus/config";
import mark from "../assets/q.svg?raw";
import wordmark from "../assets/queen.svg?raw";
import { getSidebarSections } from "@cloudflare/nimbus-docs";
import { SITE_NAV, CLOUD_LINK, isOutsideDocs } from "@/lib/site-nav";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * menu button is hidden: pages that opted out via `sidebar: false`
   * shouldn't show a button that opens an empty dialog. Default `true`.
   */
  showSidebar?: boolean;
  /**
   * Over a full-bleed hero: no background, border or blur until the page
   * scrolls, so the hero runs up under the bar. Only the homepage sets it.
   */
  transparentTop?: boolean;
}

// `entryId` is part of Props as a forward-compat hook (the version-switcher
// recipe reads it) but the base Header doesn't use it, so leave it off the
// destructure to avoid an unused-var warning.
const { collection, showSidebar = true, transparentTop = false } = Astro.props;

// Normalize trailing slash so isActive matches sidebar hrefs.
const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
const sections = await getSidebarSections(currentSlug, { collection });
const showSections = sections.length >= 2;
// Inside the docs the sidebar is the navigation, so the bar stays empty there.
// On the pages outside them, the homepage and the 404 page, it carries the
// site's own links (src/lib/site-nav.ts).
const showSiteNav = isOutsideDocs(Astro.url.pathname);
const navLink =
  "px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors";
const navIdle = "text-muted-foreground hover:text-foreground hover:bg-accent/60";
---

<header
  class="sticky top-0 z-30 border-b border-border bg-card/80 backdrop-blur-lg"
  data-transparent-top={transparentTop ? "" : undefined}
>
  {transparentTop && (
    <script is:inline>
      (() => {
        const bar = document.currentScript.parentElement;
        const sync = () => bar.toggleAttribute("data-scrolled", window.scrollY > 4);
        sync();
        addEventListener("scroll", sync, { passive: true });
      })();
    </script>
  )}
  <div class="mx-auto flex items-center justify-between h-14 px-4 lg:px-6">
    <div class="flex items-center gap-3">
      <a href="/" class="group flex items-center" aria-label={config.title}>
        {/*
          The logo, inlined (assets/logo.py writes src/assets/): the petals
          keep their yellow and the letters take the text colour of the
          theme. The home page shows the name; every other page has the room
          for the q alone. The line "message queue" stays out of this bar:
          the flower is tall, and at a height that fits here the line could
          not be read.
        */}
        {currentSlug === "/" ? (
          <span
            class="block shrink-0 text-foreground [&>svg]:block [&>svg]:h-[44px] [&>svg]:w-auto"
            set:html={wordmark}
          />
        ) : (
          <span
            class="block shrink-0 text-foreground [&>svg]:block [&>svg]:h-[40px] [&>svg]:w-auto"
            set:html={mark}
          />
        )}
      </a>

      {showSections ? (
        <nav aria-label="Sections" class="hidden md:flex items-center gap-1 ml-4 pl-4 border-l border-border h-6">
          {sections.map((section) => (
            <a
              href={section.href}
              aria-current={section.isActive ? "page" : undefined}
              class:list={[navLink, section.isActive ? "text-foreground bg-accent" : navIdle]}
            >
              {section.label}
            </a>
          ))}
        </nav>
      ) : showSiteNav && (
        <nav aria-label="Main" class="hidden md:flex items-center gap-1 ml-4 pl-4 border-l border-border h-6">
          {SITE_NAV.map((link) => (
            <a href={link.href} class:list={[navLink, navIdle]}>
              {link.label}
            </a>
          ))}
          <a href={CLOUD_LINK.href} class:list={[navLink, navIdle, "inline-flex items-center gap-1"]}>
            {CLOUD_LINK.label}
            <Icon name="ph:arrow-up-right" class="w-3 h-3" aria-hidden="true" />
          </a>
        </nav>
      )}
    </div>

    <div class="flex items-center gap-2" data-hdr-actions>
      {config.search !== false && <SearchTrigger />}
      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
          class="text-muted-foreground"
        >
          <Icon name="ph:github-logo" class="w-4 h-4" />
        </LinkButton>
      )}
      <ThemeToggle />
      {showSidebar ? (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label="Open navigation"
          data-menu-btn
          class="lg:hidden text-muted-foreground"
        />
      ) : (
        /*
          No sidebar drawer on this page (the homepage), so below md the site
          links live in a popover. The popover attribute gives the button its
          expanded state, a tap outside and Escape to close it, and the top
          layer to render in, all without a script, so the CSP's hash list does
          not grow. A <details> with a full-screen ::before could not do the
          outside tap: the header's backdrop-filter makes it the containing
          block of fixed children, so the overlay covered only the bar.
        */
        <Fragment>
          <button
            type="button"
            popovertarget="site-menu"
            aria-label="Menu"
            class="flex h-10 w-10 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground md:hidden"
          >
            <Icon name="ph:list" class="h-5 w-5" aria-hidden="true" />
          </button>
          <nav
            id="site-menu"
            popover
            aria-label="Main"
            class="site-menu w-60 rounded-xl border border-border bg-card p-1.5 text-foreground shadow-lg"
          >
            {[...SITE_NAV, CLOUD_LINK].map((link) => (
              <a
                href={link.href}
                class="flex items-center justify-between rounded-lg px-3 py-2.5 text-[0.9375rem] font-medium text-foreground no-underline transition-colors hover:bg-accent"
              >
                {link.label}
                {link.external && <Icon name="ph:arrow-up-right" class="h-4 w-4 text-muted-foreground" aria-hidden="true" />}
              </a>
            ))}
          </nav>
        </Fragment>
      )}
    </div>
  </div>
</header>

<style>
  /* A popover is centred in the viewport by default; this one hangs under the
     header's right edge, where its button is. */
  .site-menu {
    inset: calc(3.5rem + 0.5rem) 1rem auto auto;
    margin: 0;
  }
  header[data-transparent-top] {
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      backdrop-filter 200ms ease;
  }
  /* The blur goes through Tailwind's own variable: a plain `backdrop-filter:
     none` here is dropped by the CSS build, and the blur left on smears the
     page/picture boundary under a clear bar. */
  header[data-transparent-top]:not([data-scrolled]) {
    background-color: transparent;
    border-bottom-color: transparent;
    --tw-backdrop-blur: blur(0);
  }
</style>
