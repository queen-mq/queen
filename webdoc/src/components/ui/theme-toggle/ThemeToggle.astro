---
/**
 * ThemeToggle — light, dark or system. Each click moves to the next choice;
 * "system" stores nothing and follows the OS. Persists to localStorage; the
 * theme applies to `<html data-mode="dark">` via the inline script in
 * BaseLayout (no FOUC), which also sets `data-nb-pref` and the label here.
 */
import { Icon } from "astro-icon/components";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {}

const { class: className, ...attrs } = Astro.props;
---

<button
  data-nb-theme-toggle
  class={cn(
    "group flex items-center justify-center w-8 h-8 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors",
    className,
  )}
  {...attrs}
  aria-label="Theme: system"
  title="Theme: system"
  data-nb-state="light"
  data-nb-pref="system"
>
  <Icon name="ph:sun" class="w-[1.125rem] h-[1.125rem] hidden group-data-[nb-pref=light]:block" />
  <Icon name="ph:moon" class="w-[1.125rem] h-[1.125rem] hidden group-data-[nb-pref=dark]:block" />
  <Icon name="ph:desktop" class="w-[1.125rem] h-[1.125rem] hidden group-data-[nb-pref=system]:block" />
</button>

<script>
  import "./theme-toggle.client";
</script>
