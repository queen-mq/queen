{
  "name": "webdoc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node ../figures/build.mjs --site public/figures && node scripts/gen-changelog.mjs && astro dev",
    "build": "node ../figures/build.mjs --site public/figures && node scripts/gen-changelog.mjs && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/gen.mjs --check",
    "verify": "pnpm gen:check && pnpm build && pnpm check:markdown && pnpm check:brief && pnpm lint:docs && pnpm check:prose && pnpm check:sourceoftruth && pnpm check:seo && pnpm check:readme",
    "check:prose": "node scripts/check-prose.mjs",
    "check:markdown": "node scripts/check-markdown.mjs",
    "check:brief": "node scripts/check-brief.mjs",
    "check:sourceoftruth": "node scripts/check-sourceoftruth.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:readme": "node scripts/check-readme.mjs"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.20.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/ph": "^1.2.0",
    "astro": "^7.4.11",
    "astro-og-canvas": "^0.13.3",
    "canvaskit-wasm": "^0.42.0",
    "clsx": "^2.1.1",
    "mermaid": "^12.3.0",
    "satteri": "~0.10.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.5",
    "pagefind": "^1.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
